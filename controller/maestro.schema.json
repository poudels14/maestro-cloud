{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["services"],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "services": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/service"
      }
    }
  },
  "$defs": {
    "service": {
      "type": "object",
      "required": ["name", "deploy"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "build": {
          "$ref": "#/$defs/build"
        },
        "image": {
          "type": "string"
        },
        "deploy": {
          "$ref": "#/$defs/deploy"
        },
        "ingress": {
          "$ref": "#/$defs/ingress"
        }
      },
      "oneOf": [
        {
          "required": ["build"],
          "properties": {
            "image": false
          }
        },
        {
          "required": ["image"],
          "properties": {
            "build": false
          }
        }
      ]
    },
    "build": {
      "type": "object",
      "required": ["repo", "dockerfile"],
      "additionalProperties": false,
      "properties": {
        "repo": {
          "type": "string"
        },
        "branch": {
          "type": "string"
        },
        "dockerfile": {
          "type": "string"
        },
        "watch": {
          "type": "boolean",
          "default": false
        },
        "registry": {
          "type": "string",
          "description": "Container registry URL to push built images to (e.g. 123456789.dkr.ecr.us-east-1.amazonaws.com)"
        },
        "depot": {
          "type": "object",
          "required": ["project"],
          "additionalProperties": false,
          "properties": {
            "project": {
              "type": "string",
              "description": "Depot project ID used for remote builds. Requires depot.token in maestro.jsonc."
            }
          }
        },
        "env": {
          "$ref": "#/$defs/envConfig"
        },
        "secrets": {
          "$ref": "#/$defs/envConfig",
          "description": "Sensitive values made available to source fetch and build commands. GH_TOKEN here is used for private repo access."
        }
      }
    },
    "deploy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "flags": {
          "type": "array",
          "items": { "type": "string" },
          "default": []
        },
        "exposePorts": {
          "type": "array",
          "items": { "type": "integer", "minimum": 1, "maximum": 65535 },
          "default": []
        },
        "command": {
          "$ref": "#/$defs/command"
        },
        "healthcheckPath": {
          "type": "string"
        },
        "healthcheckInterval": {
          "type": "integer",
          "description": "Seconds between healthchecks once a replica is steady-state Ready. Clamped to [5, 300]. During startup (until the first successful check) and any time a replica is unhealthy, maestro rechecks every 5s regardless of this value.",
          "minimum": 5,
          "maximum": 300,
          "default": 60
        },
        "replicas": {
          "type": "integer",
          "minimum": 1,
          "default": 1
        },
        "maxRestarts": {
          "type": "integer",
          "minimum": 0
        },
        "nodeAffinity": {
          "type": "object",
          "description": "Constrain cluster placement to one node and/or nodes whose labels all match. Writable host volumes require node-id.",
          "additionalProperties": false,
          "properties": {
            "node-id": {
              "type": "string",
              "minLength": 12,
              "maxLength": 12,
              "pattern": "^[a-z0-9]{12}$"
            },
            "labels": {
              "type": "object",
              "additionalProperties": { "type": "string" }
            }
          }
        },
        "env": {
          "$ref": "#/$defs/envConfig"
        },
        "secrets": {
          "type": "object",
          "required": ["mountPath"],
          "additionalProperties": false,
          "properties": {
            "mountPath": { "type": "string" },
            "source": {
              "type": "string",
              "description": "Load all key/value pairs from a secret provider (e.g. aws-secret://secret-name)"
            },
            "items": {
              "type": "object",
              "additionalProperties": { "type": "string" }
            }
          },
          "not": {
            "required": ["source", "items"]
          }
        },
        "volumes": {
          "type": "array",
          "description": "Bind-mount host directories into the container. Equivalent to `docker run -v hostPath:containerPath`.",
          "items": {
            "type": "object",
            "required": ["hostPath", "mountPath"],
            "additionalProperties": false,
            "properties": {
              "hostPath": {
                "type": "string",
                "pattern": "^/",
                "description": "Absolute path on the host."
              },
              "mountPath": {
                "type": "string",
                "pattern": "^/",
                "description": "Absolute path inside the container where the host path is mounted."
              },
              "readOnly": {
                "type": "boolean",
                "default": false
              },
              "owner": {
                "type": "object",
                "description": "If set, maestro chowns the host path (non-recursive) before starting the container. Useful when the container's image runs as a non-root user.",
                "required": ["uid"],
                "additionalProperties": false,
                "properties": {
                  "uid": { "type": "integer", "minimum": 0 },
                  "gid": {
                    "type": "integer",
                    "minimum": 0,
                    "description": "Defaults to uid when omitted (matches the common image convention where uid == gid)."
                  }
                }
              }
            }
          },
          "default": []
        }
      }
    },
    "command": {
      "type": "object",
      "required": ["command"],
      "additionalProperties": false,
      "properties": {
        "command": {
          "type": "string"
        },
        "args": {
          "type": "array",
          "items": { "type": "string" },
          "default": []
        }
      }
    },
    "envConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source": {
          "type": "string",
          "description": "Load all key/value pairs from a secret provider (e.g. aws-secret://secret-name)"
        },
        "items": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      },
      "not": {
        "required": ["source", "items"]
      }
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "anyOf": [{ "required": ["host"] }, { "required": ["hosts"] }],
      "properties": {
        "host": {
          "type": "string"
        },
        "hosts": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "sessionAffinity": {
          "$ref": "#/$defs/sessionAffinity"
        }
      }
    },
    "sessionAffinity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["header"],
      "properties": {
        "header": {
          "type": "string",
          "minLength": 1,
          "description": "HTTP request header used for node-level session affinity. Its value must be the target Maestro node ID."
        }
      }
    }
  }
}
