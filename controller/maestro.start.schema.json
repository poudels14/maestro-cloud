{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "allOf": [
    {
      "if": {
        "not": {
          "required": ["$extends"]
        }
      },
      "then": {
        "required": ["cluster", "ingress"],
        "oneOf": [{ "required": ["encryption-key"] }, { "required": ["encryptionKey"] }],
        "properties": {
          "cluster": {
            "required": ["name"]
          },
          "tailscale": {
            "oneOf": [{ "required": ["auth-key"] }, { "required": ["authKey"] }]
          },
          "datadog": {
            "oneOf": [{ "required": ["api-key"] }, { "required": ["apiKey"] }]
          },
          "cloudflare": {
            "required": ["tunnel"],
            "properties": {
              "tunnel": {
                "required": ["token"]
              }
            }
          },
          "slack": {
            "oneOf": [{ "required": ["webhook-url"] }, { "required": ["webhookUrl"] }]
          },
          "github": {
            "required": ["token"]
          },
          "log-backup": {
            "required": ["bucket"],
            "oneOf": [{ "required": ["kms-key-id"] }, { "required": ["kmsKeyId"] }]
          },
          "logBackup": {
            "required": ["bucket"],
            "oneOf": [{ "required": ["kms-key-id"] }, { "required": ["kmsKeyId"] }]
          }
        }
      }
    },
    {
      "if": {
        "required": ["cluster"],
        "properties": {
          "cluster": {
            "required": ["nodes"],
            "properties": { "nodes": { "minProperties": 1 } }
          }
        }
      },
      "then": {
        "required": ["node"],
        "not": { "required": ["subnet"] }
      }
    }
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "$extends": {
      "type": "string",
      "minLength": 1,
      "description": "Base config source. Objects merge recursively; arrays and scalar values in this config replace inherited values."
    },
    "cluster": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "nodes": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$"
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["endpoint", "subnet"],
            "properties": {
              "endpoint": {
                "type": "string",
                "anyOf": [
                  { "format": "ipv4" },
                  { "pattern": "^[0-9]{1,3}(\\.[0-9]{1,3}){3}:[0-9]{1,5}$" }
                ],
                "description": "Private API endpoint. The API port defaults to 3000 when omitted."
              },
              "subnet": {
                "type": "string",
                "pattern": "^(?:10|172\\.(?:1[6-9]|2[0-9]|3[01])|192\\.168)\\.[0-9]{1,3}\\.0/24$"
              },
              "role": {
                "type": "string",
                "enum": ["master", "hybrid", "voter", "worker"],
                "default": "hybrid",
                "description": "Defaults to hybrid. Exactly one node must be master. Master and hybrid nodes vote and run workloads; voters are control-plane-only; workers run workloads only."
              }
            }
          },
          "description": "Shared named cluster membership and workload-subnet allocation map. Internal gateway and etcd ports are allocated automatically on each node and persisted.",
          "default": {}
        },
        "control-allow-cidrs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Optional private IPv4 source allowlist for cluster joins. When omitted, the signed join secret is the admission boundary.",
          "default": []
        },
        "controlAllowCidrs": {
          "$ref": "#/properties/cluster/properties/control-allow-cidrs"
        },
        "join-secret": {
          "type": "string",
          "minLength": 32,
          "description": "High-entropy shared secret used to authenticate automatic CA discovery and node joins."
        },
        "joinSecret": {
          "$ref": "#/properties/cluster/properties/join-secret"
        },
        "labels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "default": {}
        }
      }
    },
    "node": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$",
      "description": "Name of this machine's entry in cluster.nodes. Required in cluster mode."
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "ports": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          },
          "default": []
        }
      }
    },
    "subnet": {
      "type": "string"
    },
    "egress": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "deny": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "allow": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        }
      }
    },
    "encryption-key": {
      "type": "string"
    },
    "encryptionKey": {
      "$ref": "#/properties/encryption-key"
    },
    "tailscale": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "auth-key": {
          "type": "string"
        },
        "authKey": {
          "$ref": "#/properties/tailscale/properties/auth-key"
        },
        "advertise-routes": {
          "description": "Additional CIDRs to expose to tailnet devices, such as private VPC networks containing RDS or Redis. Maestro automatically advertises the node's container subnet separately.",
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "advertiseRoutes": {
          "$ref": "#/properties/tailscale/properties/advertise-routes"
        }
      }
    },
    "jwt-secret-key": {
      "type": "string"
    },
    "jwtSecretKey": {
      "$ref": "#/properties/jwt-secret-key"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "datadog": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "api-key": {
          "type": "string"
        },
        "apiKey": {
          "$ref": "#/properties/datadog/properties/api-key"
        },
        "site": {
          "type": "string"
        },
        "include-ingress-logs": {
          "type": "boolean",
          "default": true
        },
        "includeIngressLogs": {
          "$ref": "#/properties/datadog/properties/include-ingress-logs"
        },
        "include-tailscale-logs": {
          "type": "boolean",
          "default": true
        },
        "includeTailscaleLogs": {
          "$ref": "#/properties/datadog/properties/include-tailscale-logs"
        },
        "logs": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "include-healthcheck": {
              "type": "boolean",
              "default": true
            },
            "includeHealthcheck": {
              "$ref": "#/properties/datadog/properties/logs/properties/include-healthcheck"
            }
          }
        },
        "include-metrics": {
          "type": "boolean",
          "default": false
        },
        "includeMetrics": {
          "$ref": "#/properties/datadog/properties/include-metrics"
        }
      }
    },
    "system": {
      "type": "string",
      "enum": ["nixos"]
    },
    "runtime": {
      "type": "string",
      "enum": ["docker", "nerdctl"],
      "default": "docker"
    },
    "depot": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "token": {
          "type": "string"
        }
      }
    },
    "cloudflare": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tunnel": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "token": {
              "type": "string"
            },
            "replicas": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    },
    "slack": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "webhook-url": {
          "type": "string"
        },
        "webhookUrl": {
          "$ref": "#/properties/slack/properties/webhook-url"
        }
      }
    },
    "github": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "token": {
          "type": "string",
          "minLength": 1
        },
        "preview-domain": {
          "type": "string",
          "default": "preview.getbaton.ai"
        },
        "previewDomain": {
          "$ref": "#/properties/github/properties/preview-domain"
        },
        "poll-interval-secs": {
          "type": "integer",
          "minimum": 1,
          "default": 60
        },
        "pollIntervalSecs": {
          "$ref": "#/properties/github/properties/poll-interval-secs"
        },
        "max-concurrent-previews": {
          "type": "integer",
          "minimum": 1,
          "default": 10
        },
        "maxConcurrentPreviews": {
          "$ref": "#/properties/github/properties/max-concurrent-previews"
        }
      }
    },
    "homepage": {
      "type": "string",
      "pattern": "^https?://",
      "description": "Browser-accessible Maestro base URL used in integration links."
    },
    "log-backup": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "bucket": {
          "type": "string",
          "minLength": 1
        },
        "kms-key-id": {
          "type": "string",
          "minLength": 1
        },
        "kmsKeyId": {
          "$ref": "#/properties/log-backup/properties/kms-key-id"
        },
        "region": {
          "type": "string",
          "minLength": 1
        },
        "prefix": {
          "type": "string"
        },
        "retention-days": {
          "type": "integer",
          "minimum": 1
        },
        "retentionDays": {
          "$ref": "#/properties/log-backup/properties/retention-days"
        }
      }
    },
    "logBackup": {
      "$ref": "#/properties/log-backup"
    },
    "disable-etcd-cert": {
      "type": "boolean",
      "default": false
    },
    "disableEtcdCert": {
      "$ref": "#/properties/disable-etcd-cert"
    },
    "allow-cli-deployment": {
      "type": "boolean",
      "default": false
    },
    "allowCliDeployment": {
      "$ref": "#/properties/allow-cli-deployment"
    },
    "allow-exec": {
      "type": "boolean",
      "description": "Allow authenticated operators to open interactive exec sessions. Disabled by default.",
      "default": false
    },
    "allowExec": {
      "$ref": "#/properties/allow-exec"
    }
  }
}
