{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "allOf": [
    {
      "if": {
        "not": {
          "required": ["$extends"]
        }
      },
      "then": {
        "required": ["cluster", "ingress", "encryption-key"],
        "properties": {
          "cluster": {
            "required": ["name"]
          },
          "tailscale": {
            "required": ["auth-key"]
          },
          "datadog": {
            "required": ["api-key"]
          },
          "cloudflare": {
            "required": ["tunnel"],
            "properties": {
              "tunnel": {
                "required": ["token"]
              }
            }
          },
          "slack": {
            "required": ["webhook-url"]
          },
          "log-backup": {
            "required": ["bucket", "kms-key-id"]
          }
        }
      }
    }
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "$extends": {
      "type": "string",
      "minLength": 1,
      "description": "Base config source. Objects merge recursively; arrays and scalar values in this config replace inherited values."
    },
    "cluster": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "nodes": {
          "type": "array",
          "items": {
            "type": "string",
            "anyOf": [
              {
                "format": "ipv4"
              },
              {
                "pattern": "^[0-9]{1,3}(\\.[0-9]{1,3}){3}:[0-9]{1,5}$"
              }
            ]
          },
          "description": "Initial voter IPs, or IP:controller-port endpoints. Endpoint entries reserve API, gateway, etcd client, and etcd peer ports at P through P+3.",
          "default": []
        },
        "bind-ip": {
          "type": "string",
          "format": "ipv4"
        },
        "subnets": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "api-port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535,
          "default": 3001,
          "description": "Local controller API port. With IP:port nodes, this selects the local voter entry."
        },
        "gateway-port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535,
          "default": 3002,
          "description": "Gateway host port for legacy bare-IP node configuration; IP:port nodes derive this as controller port +1."
        },
        "control-allow-cidrs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "etcd-client-port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535,
          "default": 2379,
          "description": "etcd client host port for legacy bare-IP node configuration; IP:port nodes derive this as controller port +2."
        },
        "etcd-peer-port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535,
          "default": 2380,
          "description": "etcd peer host port for legacy bare-IP node configuration; IP:port nodes derive this as controller port +3."
        },
        "shared-registry": {
          "type": "string"
        },
        "join-secret": {
          "type": "string",
          "minLength": 32,
          "description": "High-entropy shared secret used to authenticate automatic CA discovery and node joins."
        },
        "labels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "default": {}
        }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "role": {
          "type": "string",
          "enum": ["hybrid", "voter", "worker"],
          "default": "hybrid",
          "description": "Hybrid nodes vote and run workloads; voters are control-plane-only; workers run workloads without a local etcd member."
        }
      },
      "default": {}
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "ports": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          },
          "default": []
        }
      }
    },
    "subnet": {
      "type": "string"
    },
    "egress": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "deny": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "allow": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        }
      }
    },
    "encryption-key": {
      "type": "string"
    },
    "tailscale": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "auth-key": {
          "type": "string"
        },
        "advertise-routes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        }
      }
    },
    "jwt-secret-key": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "datadog": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "api-key": {
          "type": "string"
        },
        "site": {
          "type": "string"
        },
        "include-ingress-logs": {
          "type": "boolean",
          "default": true
        },
        "include-tailscale-logs": {
          "type": "boolean",
          "default": true
        },
        "logs": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "include-healthcheck": {
              "type": "boolean",
              "default": true
            }
          }
        },
        "include-metrics": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "system": {
      "type": "string",
      "enum": ["nixos"]
    },
    "runtime": {
      "type": "string",
      "enum": ["docker", "nerdctl"],
      "default": "docker"
    },
    "depot": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "token": {
          "type": "string"
        }
      }
    },
    "cloudflare": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tunnel": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "token": {
              "type": "string"
            },
            "replicas": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    },
    "slack": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "webhook-url": {
          "type": "string"
        }
      }
    },
    "log-backup": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "bucket": {
          "type": "string",
          "minLength": 1
        },
        "kms-key-id": {
          "type": "string",
          "minLength": 1
        },
        "region": {
          "type": "string",
          "minLength": 1
        },
        "prefix": {
          "type": "string"
        },
        "retention-days": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "disable-etcd-cert": {
      "type": "boolean",
      "default": false
    },
    "allow-cli-deployment": {
      "type": "boolean",
      "default": false
    }
  }
}
