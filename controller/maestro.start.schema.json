{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["cluster", "ingress", "encryption-key"],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "cluster": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        }
      }
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "ports": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          },
          "default": []
        }
      }
    },
    "subnet": {
      "type": "string"
    },
    "egress": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "deny": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "allow": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        }
      }
    },
    "encryption-key": {
      "type": "string"
    },
    "tailscale": {
      "type": "object",
      "required": ["auth-key"],
      "additionalProperties": false,
      "properties": {
        "auth-key": {
          "type": "string"
        },
        "advertise-routes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        }
      }
    },
    "jwt-secret-key": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "datadog": {
      "type": "object",
      "required": ["api-key"],
      "additionalProperties": false,
      "properties": {
        "api-key": {
          "type": "string"
        },
        "site": {
          "type": "string"
        },
        "include-ingress-logs": {
          "type": "boolean",
          "default": true
        },
        "include-tailscale-logs": {
          "type": "boolean",
          "default": true
        },
        "logs": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "include-healthcheck": {
              "type": "boolean",
              "default": true
            }
          }
        },
        "include-metrics": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "system": {
      "type": "string",
      "enum": ["nixos"]
    },
    "runtime": {
      "type": "string",
      "enum": ["docker", "nerdctl"],
      "default": "docker"
    },
    "depot": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "token": {
          "type": "string"
        }
      }
    },
    "cloudflare": {
      "type": "object",
      "required": ["tunnel"],
      "additionalProperties": false,
      "properties": {
        "tunnel": {
          "type": "object",
          "required": ["token"],
          "additionalProperties": false,
          "properties": {
            "token": {
              "type": "string"
            },
            "replicas": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    },
    "slack": {
      "type": "object",
      "required": ["webhook-url"],
      "additionalProperties": false,
      "properties": {
        "webhook-url": {
          "type": "string"
        }
      }
    },
    "log-backup": {
      "type": "object",
      "required": ["bucket", "kms-key-id"],
      "additionalProperties": false,
      "properties": {
        "bucket": {
          "type": "string",
          "minLength": 1
        },
        "kms-key-id": {
          "type": "string",
          "minLength": 1
        },
        "region": {
          "type": "string",
          "minLength": 1
        },
        "prefix": {
          "type": "string"
        },
        "retention-days": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "disable-etcd-cert": {
      "type": "boolean",
      "default": false
    },
    "allow-cli-deployment": {
      "type": "boolean",
      "default": false
    }
  }
}
