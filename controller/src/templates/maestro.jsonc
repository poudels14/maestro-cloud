{
  "$schema": "./maestro.start.schema.json",
  "cluster": {
    "name": "my-cluster"
  },
  "ingress": {
    "port": 8080
  },
  "subnet": "172.22.0.0/16",
  "egress": {
    "deny": []
  },
  "encryption-key": "$CHANGE_ME",
  "runtime": "nerdctl",
  "depot": {
    "token": ""
  },
  "jwt-secret-key": "",
  "tailscale": {
    "auth-key": ""
  },
  "tags": [],
  "datadog": {
    "api-key": "$API_KEY",
    "site": "datadoghq.com",
    "include-ingress-logs": true,
    "include-tailscale-logs": true
  }
}
