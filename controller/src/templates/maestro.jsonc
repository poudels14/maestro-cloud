{
  "$schema": "https://raw.githubusercontent.com/poudels14/maestro-cloud/release/controller/maestro.start.schema.json",
  "cluster": {
    "name": "my-cluster"
  },
  "ingress": {
    "port": 8080
  },
  "subnet": "172.22.0.0/16",
  "egress": {
    "deny": []
  },
  "encryption-key": "$CHANGE_ME",
  "runtime": "docker",
  "tags": [],
  "allow-cli-deployment": false
}
