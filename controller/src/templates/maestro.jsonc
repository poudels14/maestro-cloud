{
  "$schema": "https://raw.githubusercontent.com/poudels14/maestro-cloud/release/controller/maestro.start.schema.json",
  // Inherit a shared config, then keep only node-specific overrides here:
  // "$extends": "aws-secret://maestro/production/common",
  "cluster": {
    "name": "my-cluster"
    // For multi-node mode, add a comma after "my-cluster" and declare every
    // node in one shared map. Exactly one node must have role "master";
    // the role of every other node defaults to "hybrid".
    // "nodes": {
    //   "node1": { "endpoint": "10.20.0.11", "subnet": "172.22.1.0/24", "role": "master" },
    //   "node2": { "endpoint": "10.20.0.12", "subnet": "172.22.2.0/24" },
    //   "node3": { "endpoint": "10.20.0.13:3100", "subnet": "172.22.3.0/24" }
    // },
    // Optional extra source restriction for signed cluster joins:
    // "control-allow-cidrs": ["10.20.0.0/24"],
    // Shared base image namespace; Maestro appends /<service-id>:<deployment-id>.
    // "image-registry": "ghcr.io/acme",
    // "join-secret": "replace-with-a-random-secret-of-at-least-32-characters"
  },
  // Required in multi-node mode; use "node2" on the second machine, etc.
  // "node": "node1",
  "ingress": {
    "port": 8080
  },
  // Standalone mode only. In cluster mode, subnet comes from cluster.nodes.
  "subnet": "172.22.1.0/24",
  "egress": {
    "deny": []
  },
  "encryption-key": "$CHANGE_ME",
  // Tailscale is optional and is not used for cluster replica traffic.
  // "tailscale": { "auth-key": "$CHANGE_ME" },
  "runtime": "docker",
  "tags": [],
  "allow-cli-deployment": false,
  // Enables `maestro ssh`; keep disabled unless operator shell access is required.
  "allow-exec": false
}
