---
source: crates/apps/daemon/src/tests/orchestration_acceptance.rs
expression: final_states
---
1-node-cancel:
  services:
    - name: acceptance-cancel
      configured_replicas: 1
      replica_override: ~
      deployments:
        - id: "[deployment-id]"
          version: v1
          phase: Canceled
          phase_history:
            - Canceled
          artifact: ~
          replicas: []
1-node-delete:
  services: []
1-node-drain-finalize:
  services:
    - name: acceptance-drain-finalize
      configured_replicas: 1
      replica_override: ~
      active_deployment_id: "[deployment-id]"
      deployments:
        - id: "[deployment-id]"
          version: v1
          phase: Removed
          phase_history:
            - Removed
          artifact: ~
          replicas: []
        - id: "[deployment-id]"
          version: v2
          phase: Ready
          phase_history:
            - Ready
          artifact: ~
          replicas:
            - index: 0
              phase: Ready
              restart_attempts: 0
              healthcheck_failures: 0
              workload: Available
              node: node-1
              workload_instance: "[workload-instance]"
1-node-drain-restore:
  services:
    - name: acceptance-node-drain
      configured_replicas: 1
      replica_override: 2
      active_deployment_id: "[deployment-id]"
      deployments:
        - id: "[deployment-id]"
          version: v1
          phase: Ready
          phase_history:
            - Ready
          artifact: ~
          replicas:
            - index: 0
              phase: Ready
              restart_attempts: 0
              healthcheck_failures: 0
              workload: Available
              node: node-1
              workload_instance: "[workload-instance]"
            - index: 1
              phase: Ready
              restart_attempts: 0
              healthcheck_failures: 0
              workload: Available
              node: node-1
              workload_instance: "[workload-instance]"
