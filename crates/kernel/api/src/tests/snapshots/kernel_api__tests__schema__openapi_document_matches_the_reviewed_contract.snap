            "description": "Time teardown may proceed after a close event."
          }
        },
        "required": [
          "phase"
        ],
        "type": "object"
      },
      "ReplicaSpread": {
        "description": "How the scheduler treats healthy placements when more eligible nodes exist.",
        "oneOf": [
          {
            "description": "Preserve healthy assignments even when a later topology could balance them better.",
            "enum": [
              "stable"
            ],
            "type": "string"
          },
          {
            "description": "Rebalance only enough healthy assignments to minimize replicas sharing a node.",
            "enum": [
              "bestEffort"
            ],
            "type": "string"
          }
        ]
      },
      "ReplicaState": {
        "$ref": "#/components/schemas/Object8"
      },
      "ReplicaStateId": {
        "description": "Stable identity of a deployment replica's observed state.",
