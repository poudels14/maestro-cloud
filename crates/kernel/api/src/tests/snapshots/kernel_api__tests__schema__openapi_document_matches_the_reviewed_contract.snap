          }
        },
        "required": [
          "spec"
        ],
        "type": "object"
      },
      "ServiceDiffResponse": {
        "description": "Masked comparison result and exact revision safe to submit on apply.",
        "properties": {
          "changes": {
            "description": "Ordered masked field changes.",
            "items": {
              "$ref": "#/components/schemas/ServiceDiffChange"
            },
