---
source: crates/kernel/api/src/tests/schema.rs
expression: openapi_document()
---
{
  "components": {
    "schemas": {
      "ArtifactArchiveId": {
        "description": "Stable identity of one uploaded artifact source archive.",
        "type": "string"
      },
      "ArtifactArchiveUploadResponse": {
        "description": "Result of accepting one content-addressed build context archive.",
        "properties": {
          "archiveId": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ArtifactArchiveId"
              }
            ],
            "description": "Content address assigned to the archive bytes."
          },
          "sizeBytes": {
            "description": "Compressed bytes accepted by the archive store.",
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "archiveId",
          "sizeBytes"
        ],
        "type": "object"
      },
      "ArtifactTemplate": {
        "description": "Runtime artifact selected for a service deployment.",
        "oneOf": [
          {
            "description": "Pull an existing immutable or tag-addressed image.",
            "properties": {
              "reference": {
                "description": "Registry image reference.",
                "type": "string"
              },
              "type": {
                "enum": [
                  "image"
                ],
                "type": "string"
              }
            },
            "required": [
              "type",
              "reference"
            ],
            "type": "object"
          },
          {
            "description": "Build an image from a source repository or uploaded archive.",
            "properties": {
              "depot": {
                "anyOf": [
                  {
                    "$ref": "#/components/schemas/DepotBuildConfig"
                  },
                  {
                    "enum": [
                      null
                    ],
                    "nullable": true
                  }
                ],
                "description": "Optional Depot remote-builder project."
              },
              "dockerfile": {
                "description": "Path to the container build definition within the source.",
                "type": "string"
              },
              "environment": {
                "additionalProperties": {
                  "type": "string"
                },
                "description": "Non-secret build variables.",
                "type": "object"
              },
              "registry": {
                "description": "Optional registry prefix receiving a deployment-unique immutable build.\n\nAbsence keeps the artifact registry-free and enables Maestro peer\nreplication between workload nodes.",
                "nullable": true,
                "type": "string"
              },
              "secrets": {
                "additionalProperties": {
                  "$ref": "#/components/schemas/SecretValue"
                },
                "description": "Secret build variables that are redacted from debug output.",
                "type": "object"
              },
              "source": {
                "allOf": [
                  {
                    "$ref": "#/components/schemas/BuildSource"
                  }
                ],
                "description": "Source material to build."
              },
              "type": {
                "enum": [
                  "build"
                ],
                "type": "string"
              },
              "watch": {
                "description": "Poll the configured Git ref and roll out newly resolved commits.",
                "type": "boolean"
              }
            },
            "required": [
              "type",
              "source",
              "dockerfile"
            ],
            "type": "object"
          }
        ]
      },
      "Assignment": {
        "$ref": "#/components/schemas/Object6"
      },
      "AssignmentId": {
        "description": "Stable identity of a scheduled workload assignment.",
        "type": "string"
      },
      "AssignmentPhase": {
        "description": "Runtime lifecycle of an assignment.",
        "oneOf": [
          {
            "description": "Waiting for the node agent to create a workload.",
            "enum": [
              "pending"
            ],
            "type": "string"
          },
          {
            "description": "The assigned workload is running.",
            "enum": [
              "running"
            ],
            "type": "string"
          },
          {
            "description": "The workload is stopping without accepting new traffic.",
            "enum": [
              "draining"
            ],
            "type": "string"
          },
          {
            "description": "The workload stopped and no longer owns runtime state.",
            "enum": [
              "stopped"
            ],
            "type": "string"
          },
          {
            "description": "The node agent could not converge the assignment.",
            "enum": [
              "failed"
            ],
            "type": "string"
          }
        ]
      },
      "AssignmentSpec": {
        "description": "Desired placement of one deployment replica on one node.",
        "properties": {
          "deploymentId": {
            "allOf": [
              {
                "$ref": "#/components/schemas/DeploymentId"
              }
            ],
            "description": "Immutable deployment being placed."
          },
          "nodeId": {
            "allOf": [
              {
                "$ref": "#/components/schemas/NodeId"
              }
            ],
            "description": "Node selected by the scheduler."
          },
          "placementEpoch": {
            "description": "Monotonic epoch incremented when a slot moves to another node.",
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "replacesAssignmentId": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/AssignmentId"
              },
              {
                "enum": [
                  null
                ],
                "nullable": true
              }
            ],
            "description": "Assignment superseded by this placement, when one is draining."
          },
          "replicaIndex": {
            "description": "Zero-based replica slot within the deployment.",
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "restartGeneration": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Generation"
              }
            ],
            "default": 1,
            "description": "Deployment workload generation this assignment realizes."
          },
          "serviceId": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ServiceId"
              }
            ],
            "description": "Service being placed."
          },
          "workloadAddress": {
            "description": "Cluster-routable address reserved before start, or absent for runtime IPAM.",
            "format": "ip",
            "nullable": true,
            "type": "string"
          }
        },
        "required": [
          "serviceId",
          "deploymentId",
          "replicaIndex",
          "nodeId",
          "placementEpoch"
        ],
        "type": "object"
      },
      "AssignmentStatus": {
        "description": "Observed workload identity and lifecycle for an assignment.",
        "properties": {
          "conditions": {
            "description": "Generic runtime and drain evidence.",
            "items": {
              "$ref": "#/components/schemas/Condition"
            },
            "type": "array"
          },
          "phase": {
            "allOf": [
              {
                "$ref": "#/components/schemas/AssignmentPhase"
              }
            ],
            "description": "Current runtime phase."
          },
          "workloadAddress": {
            "description": "Address observed after the runtime attached the workload.",
            "format": "ip",
            "nullable": true,
            "type": "string"
          },
          "workloadId": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/WorkloadId"
              },
              {
                "enum": [
                  null
                ],
                "nullable": true
              }
            ],
            "description": "Runtime workload identity created for this assignment."
          }
        },
        "required": [
          "phase"
        ],
        "type": "object"
      },
      "Build": {
        "$ref": "#/components/schemas/Object14"
      },
      "BuildId": {
        "description": "Stable identity of an artifact build.",
        "type": "string"
      },
      "BuildPhase": {
        "description": "Persisted phase of an artifact build.",
        "oneOf": [
          {
            "description": "Waiting for a build worker.",
            "enum": [
              "queued"
            ],
            "type": "string"
          },
          {
            "description": "Fetching and preparing source material.",
            "enum": [
              "preparing"
            ],
            "type": "string"
          },
          {
            "description": "Running the configured build backend.",
            "enum": [
              "building"
            ],
            "type": "string"
          },
          {
            "description": "The immutable artifact is available.",
            "enum": [
              "succeeded"
            ],
            "type": "string"
          },
          {
            "description": "The build ended with a terminal error.",
            "enum": [
              "failed"
            ],
            "type": "string"
          },
          {
            "description": "The build was canceled before completion.",
            "enum": [
              "canceled"
            ],
            "type": "string"
          }
        ]
      },
      "BuildSource": {
        "description": "Material used as the input to an artifact build.",
        "oneOf": [
          {
            "description": "A source-control repository pinned to a revision.",
            "properties": {
              "repository": {
                "description": "Repository URL.",
                "type": "string"
              },
              "revision": {
                "description": "Branch, tag, or commit selected for the build.",
                "type": "string"
              },
              "type": {
                "enum": [
                  "git"
                ],
                "type": "string"
              }
            },
            "required": [
              "type",
              "repository",
              "revision"
            ],
            "type": "object"
          },
          {
            "description": "A previously uploaded source archive.",
            "properties": {
              "archiveId": {
                "allOf": [
                  {
                    "$ref": "#/components/schemas/ArtifactArchiveId"
                  }
                ],
                "description": "Stable archive handle assigned by the upload API."
              },
              "type": {
                "enum": [
                  "tarball"
                ],
                "type": "string"
              }
            },
            "required": [
              "type",
              "archiveId"
            ],
            "type": "object"
          }
        ]
      },
      "BuildSpec": {
        "description": "Desired build source and service association.",
        "properties": {
          "deploymentId": {
            "allOf": [
              {
                "$ref": "#/components/schemas/DeploymentId"
              }
            ],
            "description": "Deployment that will consume the build."
          },
          "serviceId": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ServiceId"
              }
            ],
            "description": "Service requesting the build."
          },
          "template": {
            "allOf": [
              {
                "$ref": "#/components/schemas/BuildTemplate"
              }
            ],
            "description": "Immutable build template copied from the service."
          }
        },
        "required": [
          "serviceId",
          "deploymentId",
          "template"
        ],
        "type": "object"
      },
      "BuildStatus": {
        "description": "Observed build phase and immutable artifact identity.",
        "properties": {
          "conditions": {
            "description": "Generic progress and failure evidence.",
            "items": {
              "$ref": "#/components/schemas/Condition"
            },
            "type": "array"
          },
          "imageDigest": {
            "description": "Immutable image digest produced by a successful build.",
            "nullable": true,
            "type": "string"
          },
          "phase": {
            "allOf": [
              {
                "$ref": "#/components/schemas/BuildPhase"
              }
            ],
            "description": "Current build phase."
          },
          "sourceRevision": {
            "description": "Source revision resolved by the build backend.",
            "nullable": true,
            "type": "string"
          }
        },
        "required": [
          "phase"
        ],
        "type": "object"
      },
      "BuildTemplate": {
        "description": "Source and build environment applied to each generated build resource.",
        "properties": {
          "depot": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/DepotBuildConfig"
              },
              {
                "enum": [
                  null
                ],
                "nullable": true
              }
            ],
            "description": "Optional Depot remote-builder project."
          },
          "dockerfile": {
            "description": "Path to the container build definition within the source.",
            "type": "string"
          },
          "environment": {
            "additionalProperties": {
              "type": "string"
            },
            "description": "Non-secret build variables.",
            "type": "object"
          },
          "registry": {
            "description": "Optional registry prefix receiving a deployment-unique immutable build.\n\nAbsence keeps the artifact registry-free and enables Maestro peer\nreplication between workload nodes.",
            "nullable": true,
            "type": "string"
          },
          "secrets": {
            "additionalProperties": {
              "$ref": "#/components/schemas/SecretValue"
            },
            "description": "Secret build variables that are redacted from debug output.",
            "type": "object"
          },
          "source": {
            "allOf": [
              {
                "$ref": "#/components/schemas/BuildSource"
              }
            ],
            "description": "Source material to build."
          },
          "watch": {
            "description": "Poll the configured Git ref and roll out newly resolved commits.",
            "type": "boolean"
          }
        },
        "required": [
          "source",
          "dockerfile"
        ],
        "type": "object"
      },
      "ClusterId": {
        "description": "Stable identity of a Maestro cluster.",
        "type": "string"
      },
      "CommandRequest": {
        "additionalProperties": false,
        "description": "Optimistic lifecycle command targeting one exact resource revision.",
        "properties": {
          "expectedRevision": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ResourceRevision"
              }
            ],
            "description": "Revision the operator observed before choosing the mutation."
          }
        },
        "required": [
          "expectedRevision"
        ],
        "type": "object"
      },
      "CommandSpec": {
        "description": "Executable and argument vector passed without shell reinterpretation.",
        "properties": {
          "arguments": {
            "description": "Argument vector passed verbatim to the executable.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "executable": {
            "description": "Executable or container entrypoint.",
            "type": "string"
          }
        },
        "required": [
          "executable"
        ],
        "type": "object"
      },
      "Condition": {
        "description": "Generic status evidence rendered consistently by APIs and the panel.",
        "properties": {
          "lastTransitionTime": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Timestamp"
              }
            ],
            "description": "Time the state last changed; message-only updates do not change it."
          },
          "message": {
            "description": "Human-readable context that must not be used for machine decisions.",
            "type": "string"
          },
          "observedGeneration": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Generation"
              }
            ],
            "description": "Desired generation evaluated to produce this condition."
          },
          "reason": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ConditionReason"
              }
            ],
            "description": "Stable reason for the most recent transition."
          },
          "status": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ConditionState"
              }
            ],
            "description": "Current three-valued state."
          },
          "type": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ConditionType"
              }
            ],
            "description": "Stable condition name."
          }
        },
        "required": [
          "type",
          "status",
          "reason",
          "message",
          "observedGeneration",
          "lastTransitionTime"
        ],
        "type": "object"
      },
      "ConditionReason": {
        "description": "Stable machine-readable reason for a condition transition.",
        "type": "string"
      },
      "ConditionState": {
        "description": "Three-valued state of a status condition.",
        "oneOf": [
          {
            "description": "The condition currently holds.",
            "enum": [
              "true"
            ],
            "type": "string"
          },
          {
            "description": "The condition currently does not hold.",
            "enum": [
              "false"
            ],
            "type": "string"
          },
          {
            "description": "The controller cannot currently determine the condition.",
            "enum": [
              "unknown"
            ],
            "type": "string"
          }
        ]
      },
      "ConditionType": {
        "description": "Stable machine-readable name of a status condition.",
        "type": "string"
      },
      "Deployment": {
        "$ref": "#/components/schemas/Object5"
      },
      "DeploymentCommandResponse": {
        "description": "Result of an accepted immutable-deployment lifecycle command.",
        "properties": {
          "deploymentId": {
            "allOf": [
              {
                "$ref": "#/components/schemas/DeploymentId"
              }
            ],
            "description": "Mutated deployment identity."
          },
          "generation": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Generation"
              }
            ],
            "description": "Desired deployment generation after the command."
          },
          "goal": {
            "allOf": [
              {
                "$ref": "#/components/schemas/DeploymentGoal"
              }
            ],
            "description": "Desired lifecycle goal after the command."
          },
          "restartGeneration": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Generation"
              }
            ],
            "description": "Workload restart generation after the command."
          }
        },
        "required": [
          "deploymentId",
          "generation",
          "restartGeneration",
          "goal"
        ],
        "type": "object"
      },
      "DeploymentGoal": {
        "description": "Desired lifecycle outcome for one deployment.",
        "oneOf": [
          {
            "description": "Continue normal build, readiness, and serving reconciliation.",
            "enum": [
              "run"
            ],
            "type": "string"
          },
          {
            "description": "Cancel a deployment that has not begun serving.",
            "enum": [
              "cancel"
            ],
            "type": "string"
          },
          {
            "description": "Drain workloads and retain the terminal deployment in history.",
            "enum": [
              "remove"
            ],
            "type": "string"
          }
        ]
      },
      "DeploymentId": {
        "description": "Stable identity of one immutable service deployment.",
        "type": "string"
      },
      "DeploymentPhase": {
        "description": "Persisted phase of an immutable deployment.",
        "oneOf": [
          {
            "description": "Waiting for the deployment operator.",
            "enum": [
              "QUEUED"
            ],
            "type": "string"
          },
          {
            "description": "Preparing or resolving the deployment artifact.",
            "enum": [
              "BUILDING"
            ],
            "type": "string"
          },
          {
            "description": "Workloads started but have not passed readiness checks.",
            "enum": [
              "PENDING_READY"
            ],
            "type": "string"
          },
          {
            "description": "Workloads are healthy and may receive traffic.",
            "enum": [
              "READY"
            ],
            "type": "string"
          },
          {
            "description": "The deployment exhausted a terminal failure path.",
            "enum": [
              "CRASHED"
            ],
            "type": "string"
          },
          {
            "description": "Runtime workloads have stopped.",
            "enum": [
              "TERMINATED"
            ],
            "type": "string"
          },
          {
            "description": "Persistent deployment state is eligible for deletion.",
            "enum": [
              "REMOVED"
            ],
            "type": "string"
          },
          {
            "description": "Traffic is leaving the deployment while requests drain.",
            "enum": [
              "DRAINING"
            ],
            "type": "string"
          },
          {
            "description": "The queued or building deployment was canceled.",
            "enum": [
              "CANCELED"
            ],
            "type": "string"
          }
        ]
      },
      "DeploymentSpec": {
        "description": "Captured service snapshot and desired lifecycle for one deployment.",
        "properties": {
          "buildId": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/BuildId"
              },
              {
                "enum": [
                  null
                ],
                "nullable": true
              }
            ],
            "description": "Build generated for this deployment, when the artifact needs building."
          },
          "bypassRolloutFreeze": {
            "default": false,
            "description": "Whether this immutable deployment may begin while its service is frozen.",
            "type": "boolean"
          },
          "goal": {
            "allOf": [
              {
                "$ref": "#/components/schemas/DeploymentGoal"
              }
            ],
            "default": "run",
            "description": "User-requested lifecycle outcome reconciled by the deployment operator."
          },
          "restartGeneration": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Generation"
              }
            ],
            "default": 1,
            "description": "Desired workload generation, incremented to restart this deployment in place."
          },
          "service": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ServiceSpec"
              }
            ],
            "description": "Immutable service configuration used for every replica."
          },
          "serviceGeneration": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Generation"
              }
            ],
            "description": "Service generation captured when the deployment was queued."
          },
          "serviceId": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ServiceId"
              }
            ],
            "description": "Service that owns this deployment."
          }
        },
        "required": [
          "serviceId",
          "serviceGeneration",
          "service"
        ],
        "type": "object"
      },
      "DeploymentStatus": {
        "description": "Observed lifecycle, artifact, and timing of one deployment.",
        "properties": {
          "conditions": {
            "description": "Generic lifecycle and availability evidence.",
            "items": {
              "$ref": "#/components/schemas/Condition"
            },
            "type": "array"
          },
          "createdAt": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Timestamp"
              }
            ],
            "description": "Time the deployment was created."
          },
          "drainingAt": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Timestamp"
              },
              {
                "enum": [
                  null
                ],
                "nullable": true
              }
            ],
            "description": "Time draining began."
          },
          "imageDigest": {
            "description": "Immutable image digest selected or produced for workloads.",
            "nullable": true,
            "type": "string"
          },
          "phase": {
            "allOf": [
              {
                "$ref": "#/components/schemas/DeploymentPhase"
              }
            ],
            "description": "Current lifecycle phase."
          },
          "readyAt": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Timestamp"
              },
              {
                "enum": [
                  null
                ],
                "nullable": true
              }
            ],
            "description": "Time the deployment first became ready."
          }
        },
        "required": [
          "phase",
          "createdAt"
        ],
        "type": "object"
      },
      "DepotBuildConfig": {
        "additionalProperties": false,
        "description": "Service-level selection for Depot's remote builder infrastructure.",
        "properties": {
          "project": {
            "description": "Depot project ID receiving the remote build.",
            "type": "string"
          }
        },
        "required": [
          "project"
        ],
        "type": "object"
      },
      "DnsRecord": {
        "$ref": "#/components/schemas/Object13"
      },
      "DnsRecordId": {
        "description": "Stable identity of a cluster DNS record.",
        "type": "string"
      },
      "DnsRecordSpec": {
        "description": "Desired authoritative DNS record set.",
        "properties": {
          "name": {
            "description": "Fully qualified record name.",
            "type": "string"
          },
          "ttlSecs": {
            "description": "DNS cache lifetime.",
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "values": {
            "description": "Homogeneous values published for the name.",
            "items": {
              "$ref": "#/components/schemas/DnsRecordValue"
            },
            "type": "array"
          }
        },
        "required": [
          "name",
          "values",
          "ttlSecs"
        ],
        "type": "object"
      },
      "DnsRecordStatus": {
        "description": "Observed publication state of a DNS record set.",
        "properties": {
          "appliedGeneration": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Generation"
              }
            ],
            "description": "Desired generation most recently loaded by node resolvers."
          },
          "conditions": {
            "description": "Generic validation and publication evidence.",
            "items": {
              "$ref": "#/components/schemas/Condition"
            },
            "type": "array"
          },
          "publishedNodes": {
            "description": "Nodes that acknowledged this record generation.",
            "items": {
              "$ref": "#/components/schemas/NodeId"
            },
            "type": "array"
          }
        },
        "required": [
          "appliedGeneration"
        ],
        "type": "object"
      },
      "DnsRecordValue": {
        "description": "A typed value stored in one authoritative DNS record set.",
        "oneOf": [
          {
            "description": "IPv4 address record.",
            "properties": {
              "type": {
                "enum": [
                  "a"
                ],
                "type": "string"
              },
              "value": {
                "format": "ipv4",
                "type": "string"
              }
            },
            "required": [
              "type",
              "value"
            ],
            "type": "object"
          },
          {
            "description": "IPv6 address record.",
            "properties": {
              "type": {
                "enum": [
                  "aaaa"
                ],
                "type": "string"
              },
              "value": {
                "format": "ipv6",
                "type": "string"
              }
            },
            "required": [
              "type",
              "value"
            ],
            "type": "object"
          },
          {
            "description": "Canonical-name target.",
            "properties": {
              "type": {
                "enum": [
                  "cname"
                ],
                "type": "string"
              },
              "value": {
                "type": "string"
              }
            },
            "required": [
              "type",
              "value"
            ],
            "type": "object"
          },
          {
            "description": "Arbitrary text record.",
            "properties": {
              "type": {
                "enum": [
                  "txt"
                ],
                "type": "string"
              },
              "value": {
                "type": "string"
              }
            },
            "required": [
              "type",
              "value"
            ],
            "type": "object"
          },
          {
            "description": "Service location record.",
            "properties": {
              "type": {
                "enum": [
                  "srv"
                ],
                "type": "string"
              },
              "value": {
                "properties": {
                  "port": {
                    "description": "Target service port.",
                    "format": "uint16",
                    "maximum": 65535,
                    "minimum": 0,
                    "type": "integer"
                  },
                  "priority": {
                    "description": "Target selection priority.",
                    "format": "uint16",
                    "maximum": 65535,
                    "minimum": 0,
                    "type": "integer"
                  },
                  "target": {
                    "description": "Canonical target hostname.",
                    "type": "string"
                  },
                  "weight": {
                    "description": "Relative target weight within one priority.",
                    "format": "uint16",
                    "maximum": 65535,
                    "minimum": 0,
                    "type": "integer"
                  }
                },
                "required": [
                  "priority",
                  "weight",
                  "port",
                  "target"
                ],
                "type": "object"
              }
            },
            "required": [
              "type",
              "value"
            ],
            "type": "object"
          }
        ]
      },
      "ExecPolicy": {
        "description": "Whether API-initiated interactive execution is available to a workload.",
        "oneOf": [
          {
            "description": "Authenticated exec sessions are allowed.",
            "enum": [
              "allowed"
            ],
            "type": "string"
          },
          {
            "description": "Exec sessions are rejected.",
            "enum": [
              "denied"
            ],
            "type": "string"
          }
        ]
      },
      "FinalizerName": {
        "description": "A finalizer registered by a controller before deletion can complete.",
        "type": "string"
      },
      "FirewallDirection": {
        "description": "Network direction governed by a firewall policy.",
        "oneOf": [
          {
            "description": "Traffic initiated by workloads.",
            "enum": [
              "egress"
            ],
            "type": "string"
          },
          {
            "description": "Traffic entering a node's protected host plane.",
            "enum": [
              "hostInput"
            ],
            "type": "string"
          }
        ]
      },
      "FirewallPolicy": {
        "$ref": "#/components/schemas/Object12"
      },
      "FirewallPolicyId": {
        "description": "Stable identity of an effective firewall policy.",
        "type": "string"
      },
      "FirewallPolicySpec": {
        "description": "Desired ordered firewall policy.",
        "properties": {
          "defaultVerdict": {
            "allOf": [
              {
                "$ref": "#/components/schemas/FirewallVerdict"
              }
            ],
            "description": "Verdict when no rule matches."
          },
          "direction": {
            "allOf": [
              {
                "$ref": "#/components/schemas/FirewallDirection"
              }
            ],
            "description": "Network direction governed by the policy."
          },
          "rules": {
            "description": "Ordered rules evaluated before the default verdict.",
            "items": {
              "$ref": "#/components/schemas/FirewallRule"
            },
            "type": "array"
          },
          "subject": {
            "allOf": [
              {
                "$ref": "#/components/schemas/FirewallSubject"
              }
            ],
            "description": "Resource scope governed by the policy."
          }
        },
        "required": [
          "direction",
          "subject",
          "defaultVerdict"
        ],
        "type": "object"
      },
      "FirewallPolicyStatus": {
        "description": "Observed atomic application state of a firewall policy.",
        "properties": {
          "appliedGeneration": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Generation"
              }
            ],
            "description": "Desired generation most recently applied to the backend."
          },
          "conditions": {
            "description": "Generic validation and application evidence.",
            "items": {
              "$ref": "#/components/schemas/Condition"
            },
            "type": "array"
          },
          "rulesetDigest": {
            "description": "Hash of the exact ruleset handed to the firewall backend.",
            "nullable": true,
            "type": "string"
          }
        },
        "required": [
          "appliedGeneration"
        ],
        "type": "object"
      },
      "FirewallRule": {
        "description": "One ordered firewall match and action.",
        "properties": {
          "cidr": {
            "description": "Canonical destination or source CIDR, depending on policy direction.",
            "type": "string"
          },
          "ports": {
            "description": "Port ranges to match, or every port when empty.",
            "items": {
              "$ref": "#/components/schemas/PortRange"
            },
            "type": "array"
          },
          "protocol": {
            "allOf": [
              {
                "$ref": "#/components/schemas/TransportProtocol"
              }
            ],
            "description": "Transport protocol to match."
          },
          "verdict": {
            "allOf": [
              {
                "$ref": "#/components/schemas/FirewallVerdict"
              }
            ],
            "description": "Action applied to matching traffic."
          }
        },
        "required": [
          "cidr",
          "protocol",
          "verdict"
        ],
        "type": "object"
      },
      "FirewallSubject": {
        "description": "Resource scope that a firewall policy governs.",
        "oneOf": [
          {
            "description": "Every workload or node, depending on direction.",
            "properties": {
              "type": {
                "enum": [
                  "global"
                ],
                "type": "string"
              }
            },
            "required": [
              "type"
            ],
            "type": "object"
          },
          {
            "description": "Workloads belonging to one service.",
            "properties": {
              "id": {
                "$ref": "#/components/schemas/ServiceId"
              },
              "type": {
                "enum": [
                  "service"
                ],
                "type": "string"
              }
            },
            "required": [
              "type",
              "id"
            ],
            "type": "object"
          },
          {
            "description": "Host-input traffic for one node.",
            "properties": {
              "id": {
                "$ref": "#/components/schemas/NodeId"
              },
              "type": {
                "enum": [
                  "node"
                ],
                "type": "string"
              }
            },
            "required": [
              "type",
              "id"
            ],
            "type": "object"
          }
        ]
      },
      "FirewallVerdict": {
        "description": "Action applied when a firewall rule matches.",
        "oneOf": [
          {
            "description": "Permit matching traffic.",
            "enum": [
              "allow"
            ],
            "type": "string"
          },
          {
            "description": "Reject matching traffic.",
            "enum": [
              "deny"
            ],
            "type": "string"
          }
        ]
      },
      "Generation": {
        "description": "Monotonic desired-state generation assigned when a resource specification changes.",
        "format": "uint64",
        "minimum": 0,
        "type": "integer"
      },
      "HealthCheckSpec": {
        "description": "Timing and failure policy for a workload health probe.",
        "properties": {
          "intervalSecs": {
            "description": "Interval between scheduled probes.",
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "probe": {
            "allOf": [
              {
                "$ref": "#/components/schemas/HealthProbe"
              }
            ],
            "description": "Probe to perform."
          },
          "unhealthyThreshold": {
            "description": "Consecutive failures required before a replica is unhealthy.",
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "probe",
          "intervalSecs",
          "unhealthyThreshold"
        ],
        "type": "object"
      },
      "HealthProbe": {
        "description": "Health probe performed against a running workload address.",
        "oneOf": [
          {
            "description": "HTTP GET probe requiring a successful response.",
            "properties": {
              "path": {
                "description": "Absolute request path.",
                "type": "string"
              },
              "port": {
                "description": "Workload port to probe.",
                "format": "uint16",
                "maximum": 65535,
                "minimum": 0,
                "type": "integer"
              },
              "protocol": {
                "enum": [
                  "http"
                ],
                "type": "string"
              }
            },
            "required": [
              "protocol",
              "port",
              "path"
            ],
            "type": "object"
          },
          {
            "description": "TCP connection probe.",
            "properties": {
              "port": {
                "description": "Workload port to probe.",
                "format": "uint16",
                "maximum": 65535,
                "minimum": 0,
                "type": "integer"
              },
              "protocol": {
                "enum": [
                  "tcp"
                ],
                "type": "string"
              }
            },
            "required": [
              "protocol",
              "port"
            ],
            "type": "object"
          }
        ]
      },
      "IngressBlocklist": {
        "$ref": "#/components/schemas/Object10"
      },
      "IngressBlocklistId": {
        "description": "Stable identity of the cluster ingress blocklist.",
        "type": "string"
      },
      "IngressBlocklistSpec": {
        "description": "Desired canonical client addresses denied before service routing.",
        "properties": {
          "addresses": {
            "description": "Unique addresses in deterministic network ordering.",
            "items": {
              "format": "ip",
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "addresses"
        ],
        "type": "object"
      },
      "IngressBlocklistStatus": {
        "description": "Observed publication state for the cluster ingress blocklist.",
        "properties": {
          "appliedGeneration": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Generation"
              }
            ],
            "description": "Desired generation most recently published to the ingress backend."
          },
          "conditions": {
            "description": "Generic publication and validation evidence.",
            "items": {
              "$ref": "#/components/schemas/Condition"
            },
            "type": "array"
          },
          "configurationDigest": {
            "description": "Digest of the exact rendered address set.",
            "nullable": true,
            "type": "string"
          }
        },
        "required": [
          "appliedGeneration"
        ],
        "type": "object"
      },
      "IngressRoute": {
        "$ref": "#/components/schemas/Object9"
      },
      "IngressRouteId": {
        "description": "Stable identity of an ingress route.",
        "type": "string"
      },
      "IngressRouteSpec": {
        "description": "Desired host routing for one service endpoint.",
        "properties": {
          "hosts": {
            "description": "Canonical hostnames accepted by the route.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "pathPrefix": {
            "description": "Optional path prefix required after the host matches.",
            "nullable": true,
            "type": "string"
          },
          "serviceId": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ServiceId"
              }
            ],
            "description": "Service receiving matching requests."
          },
          "sessionAffinity": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/SessionAffinity"
              },
              {
                "enum": [
                  null
                ],
                "nullable": true
              }
            ],
            "description": "Optional opaque header affinity policy."
          },
          "targetPort": {
            "description": "Workload port receiving requests.",
            "format": "uint16",
            "maximum": 65535,
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "serviceId",
          "hosts",
          "targetPort"
        ],
        "type": "object"
      },
      "IngressRouteStatus": {
        "description": "Observed route publication state.",
        "properties": {
          "appliedGeneration": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Generation"
              }
            ],
            "description": "Route generation most recently published by ingress."
          },
          "conditions": {
            "description": "Generic publication and validation evidence.",
            "items": {
              "$ref": "#/components/schemas/Condition"
            },
            "type": "array"
          }
        },
        "required": [
          "appliedGeneration"
        ],
        "type": "object"
      },
      "IngressRouting": {
        "description": "One logical route currently receiving public ingress traffic.",
        "properties": {
          "entryPoints": {
            "description": "Public Traefik entry points evaluating the rule.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "rule": {
            "description": "Exact Traefik rule published for the route.",
            "type": "string"
          },
          "servers": {
            "description": "Ready workload URLs selected by the active traffic generation.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "serviceId": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ServiceId"
              }
            ],
            "description": "Service receiving traffic through this route."
          }
        },
        "required": [
          "serviceId",
          "rule",
          "entryPoints",
          "servers"
        ],
        "type": "object"
      },
      "MaskedCloudflareConfig": {
        "description": "Secret-free view of the remotely managed Cloudflare Tunnel connector fleet.",
        "properties": {
          "tunnel": {
            "allOf": [
              {
                "$ref": "#/components/schemas/MaskedCloudflareTunnelConfig"
              }
            ],
            "description": "Remotely managed tunnel connector settings."
          }
        },
        "required": [
          "tunnel"
        ],
        "type": "object"
      },
      "MaskedCloudflareTunnelConfig": {
        "description": "Secret-free view of one Cloudflare Tunnel connector fleet.",
        "properties": {
          "replicas": {
            "description": "Desired number of highly available connector workloads.",
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "replicas"
        ],
        "type": "object"
      },
      "MaskedClusterConfig": {
        "description": "Secret-free cluster configuration returned to authenticated operators.\n\nThis is deliberately a separate wire contract from the daemon's parsed\nconfiguration so adding a secret-bearing daemon field cannot expose it.",
        "properties": {
          "cloudflare": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/MaskedCloudflareConfig"
              },
              {
                "enum": [
                  null
                ],
                "nullable": true
              }
            ],
            "description": "Optional Cloudflare Tunnel settings with the connector token omitted."
          },
          "clusterId": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ClusterId"
              }
            ],
            "description": "Stable cluster identity."
          },
          "controlAllowCidrs": {
            "description": "Private networks allowed to initiate control-plane traffic.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "localNodeId": {
            "allOf": [
              {
                "$ref": "#/components/schemas/NodeId"
              }
            ],
            "description": "Node serving this view."
          },
          "name": {
            "description": "Human-readable DNS-safe cluster name.",
            "type": "string"
          },
          "nodes": {
            "description": "Declared cluster members in stable node-ID order.",
            "items": {
              "$ref": "#/components/schemas/MaskedClusterConfigNode"
            },
            "type": "array"
          },
          "ports": {
            "allOf": [
              {
                "$ref": "#/components/schemas/MaskedClusterConfigPorts"
              }
            ],
            "description": "Cluster-wide service ports."
          },
          "tailscale": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/MaskedTailscaleConfig"
              },
              {
                "enum": [
                  null
                ],
                "nullable": true
              }
            ],
            "description": "Optional Tailscale gateway settings with the credential omitted."
          }
        },
        "required": [
          "clusterId",
          "name",
          "localNodeId",
          "nodes",
          "controlAllowCidrs",
          "ports"
        ],
        "type": "object"
      },
      "MaskedClusterConfigNode": {
        "description": "Secret-free topology for one configured cluster member.",
        "properties": {
          "apiPort": {
            "description": "Public API port for this node.",
            "format": "uint16",
            "maximum": 65535,
            "minimum": 0,
            "type": "integer"
          },
          "hostAddress": {
            "description": "Private control-plane address advertised to peers.",
            "type": "string"
          },
          "hostname": {
            "description": "Configured node hostname.",
            "type": "string"
          },
          "nodeId": {
            "allOf": [
              {
                "$ref": "#/components/schemas/NodeId"
              }
            ],
            "description": "Stable node identity."
          },
          "role": {
            "allOf": [
              {
                "$ref": "#/components/schemas/NodeRole"
              }
            ],
            "description": "Scheduling and control-plane capability."
          },
          "workloadSubnet": {
            "description": "Private workload subnet assigned to this node.",
            "type": "string"
          }
        },
        "required": [
          "nodeId",
          "hostname",
          "role",
          "hostAddress",
          "apiPort",
          "workloadSubnet"
        ],
        "type": "object"
      },
      "MaskedClusterConfigPorts": {
        "description": "Secret-free cluster-wide port allocation.",
        "properties": {
          "gateway": {
            "description": "Cluster gateway listener port.",
            "format": "uint16",
            "maximum": 65535,
            "minimum": 0,
            "type": "integer"
          },
          "storeClient": {
            "description": "Internal store client port.",
            "format": "uint16",
            "maximum": 65535,
            "minimum": 0,
            "type": "integer"
          },
          "storePeer": {
            "description": "Internal store membership port.",
            "format": "uint16",
            "maximum": 65535,
            "minimum": 0,
            "type": "integer"
          },
          "wireguard": {
            "description": "WireGuard mesh UDP port.",
            "format": "uint16",
            "maximum": 65535,
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "gateway",
          "storeClient",
          "storePeer",
          "wireguard"
        ],
        "type": "object"
      },
      "MaskedCrossClusterDnsRoute": {
        "description": "Secret-free view of one scoped remote DNS route.",
        "properties": {
          "clusterId": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ClusterId"
              }
            ],
            "description": "Remote cluster identity embedded in its authoritative DNS suffix."
          },
          "nameservers": {
            "description": "Remote bridge resolver addresses reachable through Tailscale.",
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "clusterId",
          "nameservers"
        ],
        "type": "object"
      },
      "MaskedTailscaleConfig": {
        "description": "Secret-free view of the managed Tailscale gateway fleet.",
        "properties": {
          "advertiseRoutes": {
            "description": "Effective routes advertised to the tailnet.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "crossClusterDns": {
            "description": "Explicit remote cluster suffixes forwarded through the managed gateways.",
            "items": {
              "$ref": "#/components/schemas/MaskedCrossClusterDnsRoute"
            },
            "type": "array"
          },
          "dnsNameservers": {
            "description": "Cluster bridge resolvers reachable through the advertised routes.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "replicas": {
            "description": "Desired gateway replica count.",
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "tags": {
            "description": "Tailnet policy tags applied during authentication.",
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "advertiseRoutes",
          "dnsNameservers",
          "replicas",
          "tags",
          "crossClusterDns"
        ],
        "type": "object"
      },
      "Node": {
        "$ref": "#/components/schemas/Object"
      },
      "NodeApiAccess": {
        "description": "Workload access to the private node API mounted at `/run/maestro`.",
        "oneOf": [
          {
            "description": "No node API credentials or socket are mounted.",
            "enum": [
              "disabled"
            ],
            "type": "string"
          },
          {
            "description": "Downward identity and authenticated OTLP ingest are available.",
            "enum": [
              "identityAndTelemetry"
            ],
            "type": "string"
          },
          {
            "description": "Identity, telemetry, and privileged Control mutations are available.",
            "enum": [
              "privileged"
            ],
            "type": "string"
          }
        ]
      },
      "NodeFirewall": {
        "$ref": "#/components/schemas/Object18"
      },
      "NodeFirewallId": {
        "description": "Stable identity of a node's desired firewall ruleset.",
        "type": "string"
      },
      "NodeFirewallSpec": {
        "description": "Complete generated nftables input desired on one node.",
        "properties": {
          "digest": {
            "description": "SHA-256 digest of the exact script bytes.",
            "type": "string"
          },
          "nodeId": {
            "allOf": [
              {
                "$ref": "#/components/schemas/NodeId"
              }
            ],
            "description": "Node whose host and forwarding hooks own this ruleset."
          },
          "script": {
            "description": "Complete input applied in one atomic `nft -f` transaction.",
            "type": "string"
          },
          "tableName": {
            "description": "Owned nftables table replaced by the script.",
            "type": "string"
          }
        },
        "required": [
          "nodeId",
          "tableName",
          "script",
          "digest"
        ],
        "type": "object"
      },
      "NodeFirewallStatus": {
        "description": "Node-local application evidence for one desired firewall generation.",
        "properties": {
          "appliedDigest": {
            "description": "Digest of the exact script accepted by the backend.",
            "nullable": true,
            "type": "string"
          },
          "appliedGeneration": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Generation"
              }
            ],
            "description": "Desired generation most recently applied by the node agent."
          },
          "conditions": {
            "description": "Generic validation and application evidence.",
            "items": {
              "$ref": "#/components/schemas/Condition"
            },
            "type": "array"
          }
        },
        "required": [
          "appliedGeneration"
        ],
        "type": "object"
      },
      "NodeId": {
        "description": "Stable identity of a cluster node.",
        "type": "string"
      },
      "NodeInstanceId": {
        "description": "Identity of one running daemon instance on a cluster node.",
        "type": "string"
      },
      "NodeNetwork": {
        "$ref": "#/components/schemas/Object3"
      },
      "NodeNetworkId": {
        "description": "Stable identity of a node's published network configuration.",
        "type": "string"
      },
      "NodeNetworkSpec": {
        "description": "Desired WireGuard publication and workload subnet for one node.",
        "properties": {
          "endpoint": {
            "description": "Directly reachable WireGuard UDP endpoint.",
            "type": "string"
          },
          "mtuBytes": {
            "description": "Mesh interface MTU applied to both WireGuard and workload networking.",
            "format": "uint16",
            "maximum": 65535,
            "minimum": 0,
            "type": "integer"
          },
          "nodeId": {
            "allOf": [
              {
                "$ref": "#/components/schemas/NodeId"
              }
            ],
            "description": "Node that owns the private key corresponding to this publication."
          },
          "publicKey": {
            "description": "WireGuard public key; the private key is never stored in a resource.",
            "type": "string"
          },
          "workloadSubnet": {
            "description": "Canonical CIDR reserved for workloads on the node.",
            "type": "string"
          }
        },
        "required": [
          "nodeId",
          "publicKey",
          "endpoint",
          "workloadSubnet",
          "mtuBytes"
        ],
        "type": "object"
      },
      "NodeNetworkStatus": {
        "description": "Observed mesh programming state for one node network.",
        "properties": {
          "appliedGeneration": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Generation"
              }
            ],
            "description": "Desired generation most recently applied by the node agent."
          },
          "conditions": {
            "description": "Generic readiness and configuration evidence.",
            "items": {
              "$ref": "#/components/schemas/Condition"
            },
            "type": "array"
          }
        },
        "required": [
          "appliedGeneration"
        ],
        "type": "object"
      },
      "NodeRole": {
        "description": "Scheduling and control-plane capability assigned to a node.",
        "oneOf": [
          {
            "description": "Initial control-plane node that can bootstrap a cluster and run workloads.",
            "enum": [
              "master"
            ],
            "type": "string"
          },
          {
            "description": "Control-plane node that also runs workloads.",
            "enum": [
              "hybrid"
            ],
            "type": "string"
          },
          {
            "description": "Control-plane node that does not run user workloads.",
            "enum": [
              "controlPlane"
            ],
            "type": "string"
          },
          {
            "description": "Workload node without control-plane responsibility.",
            "enum": [
              "worker"
            ],
            "type": "string"
          }
        ]
      },
      "NodeSpec": {
        "description": "Desired identity and connectivity of a cluster node.",
        "properties": {
          "hostAddress": {
            "description": "Stable host address used for control-plane traffic.",
            "format": "ip",
            "type": "string"
          },
          "hostname": {
            "description": "Operator-facing hostname.",
            "type": "string"
          },
          "role": {
            "allOf": [
              {
                "$ref": "#/components/schemas/NodeRole"
              }
            ],
            "description": "Scheduling and control-plane capability."
          },
          "schedulingLabels": {
            "additionalProperties": {
              "type": "string"
            },
            "description": "Arbitrary scheduling labels advertised by the node.",
            "type": "object"
          },
          "workloadNetworkMode": {
            "allOf": [
              {
                "$ref": "#/components/schemas/WorkloadNetworkMode"
              }
            ],
            "default": "clusterRouted",
            "description": "Workload address ownership and network capability."
          }
        },
        "required": [
          "hostname",
          "hostAddress",
          "role"
        ],
        "type": "object"
      },
      "NodeStatus": {
        "description": "Current reachability and lifecycle of a cluster node.",
        "properties": {
          "conditions": {
            "description": "Generic readiness, availability, drain, and maintenance evidence.",
            "items": {
              "$ref": "#/components/schemas/Condition"
            },
            "type": "array"
          },
          "instanceId": {
            "allOf": [
              {
                "$ref": "#/components/schemas/NodeInstanceId"
              }
            ],
            "description": "Identity of the currently running daemon instance."
          },
          "lastSeen": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Timestamp"
              }
            ],
            "description": "Last time the node renewed its liveness session."
          },
          "version": {
            "default": "",
            "description": "Semantic version reported by the currently running daemon.",
            "type": "string"
          }
        },
        "required": [
          "instanceId",
          "lastSeen"
        ],
        "type": "object"
      },
      "NodeTombstone": {
        "$ref": "#/components/schemas/Object2"
      },
      "NodeTombstoneSpec": {
        "description": "Immutable identity and topology evidence retained after node removal.",
        "properties": {
          "hostAddress": {
            "description": "Last private control-plane address owned by the removed node.",
            "format": "ip",
            "type": "string"
          },
          "requestedAt": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Timestamp"
              }
            ],
            "description": "Time at which removal was requested."
          },
          "role": {
            "allOf": [
              {
                "$ref": "#/components/schemas/NodeRole"
              }
            ],
            "description": "Last cluster role held by the removed node."
          }
        },
        "required": [
          "hostAddress",
          "role",
          "requestedAt"
        ],
        "type": "object"
      },
      "NodeTombstoneStatus": {
        "description": "Observed completion of one irreversible node-identity removal.",
        "properties": {
          "removedAt": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Timestamp"
              }
            ],
            "description": "Time at which membership and durable node state were removed."
          }
        },
        "required": [
          "removedAt"
        ],
        "type": "object"
      },
      "NodeUpgradeStatus": {
        "description": "Per-node progress retained across leader changes and daemon restarts.",
        "properties": {
          "attempts": {
            "description": "Attempts consumed by retryable upgrade failures.",
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "nodeId": {
            "allOf": [
              {
                "$ref": "#/components/schemas/NodeId"
              }
            ],
            "description": "Node being upgraded."
          },
          "observedVersion": {
            "description": "Version last reported by the node.",
            "nullable": true,
            "type": "string"
          },
          "phase": {
            "allOf": [
              {
                "$ref": "#/components/schemas/UpgradePhase"
              }
            ],
            "description": "Current phase for this node."
          },
          "previousInstanceId": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/NodeInstanceId"
              },
              {
                "enum": [
                  null
                ],
                "nullable": true
              }
            ],
            "description": "Process identity observed before restart."
          },
          "retryAt": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Timestamp"
              },
              {
                "enum": [
                  null
                ],
                "nullable": true
              }
            ],
            "description": "Earliest time another idempotent upgrade dispatch may be attempted."
          }
        },
        "required": [
          "nodeId",
          "phase",
          "attempts"
        ],
        "type": "object"
      },
