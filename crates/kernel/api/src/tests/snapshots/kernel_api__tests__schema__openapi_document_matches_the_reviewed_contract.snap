              }
            },
            "required": [
              "format",
              "mountPath"
            ],
            "type": "object"
          },
          {
            "description": "One directory containing named files with exact secret bytes.",
            "properties": {
              "files": {
                "additionalProperties": {
                  "$ref": "#/components/schemas/SecretValue"
                },
                "description": "Single-component file names and plaintext contents encrypted by the store boundary.",
                "type": "object"
              },
              "format": {
                "enum": [
                  "files"
                ],
                "type": "string"
              },
              "mountPath": {
                "description": "Absolute workload-visible directory path.",
                "type": "string"
              }
            },
            "required": [
              "format",
              "mountPath",
              "files"
            ],
            "type": "object"
          }
