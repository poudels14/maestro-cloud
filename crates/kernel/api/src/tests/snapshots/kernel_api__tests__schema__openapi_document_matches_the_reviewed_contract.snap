      },
      "ObjectMeta9": {
        "description": "Metadata shared by every resource kind.",
        "properties": {
          "annotations": {
            "additionalProperties": {
              "type": "string"
            },
            "description": "Non-selecting metadata interpreted by named consumers.",
            "type": "object"
          },
          "deletionTimestamp": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Timestamp"
              },
              {
                "enum": [
                  null
                ],
                "nullable": true
              }
            ],
            "description": "Time deletion was requested, or `None` while the resource is active."
          },
          "finalizers": {
            "description": "Controllers that must finish cleanup before physical deletion.",
            "items": {
              "$ref": "#/components/schemas/FinalizerName"
            },
            "type": "array",
            "uniqueItems": true
          },
          "generation": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Generation"
              }
            ],
            "description": "Desired-state generation incremented when the specification changes."
          },
          "id": {
            "allOf": [
              {
                "$ref": "#/components/schemas/FirewallPolicyId"
              }
            ],
            "description": "Kind-specific stable resource identity."
          },
          "labels": {
            "additionalProperties": {
              "type": "string"
            },
            "description": "Labels used by selectors and grouping.",
            "type": "object"
          },
          "ownerRefs": {
            "description": "Resources whose lifecycle or provenance relates to this object.",
            "items": {
              "$ref": "#/components/schemas/OwnerReference"
            },
            "type": "array"
          },
          "revision": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ResourceRevision"
              }
            ],
            "description": "Store revision used for optimistic concurrency."
          }
        },
        "required": [
          "id",
          "revision",
          "generation"
        ],
        "type": "object"
      },
      "OwnerReference": {
        "description": "A typed reference to a resource that created or manages another resource.",
        "properties": {
          "ownership": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Ownership"
              }
            ],
            "description": "Whether the owner controls cascading deletion."
          },
          "resource": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ResourceId"
              }
            ],
            "description": "Identity and kind of the owner."
          }
        },
        "required": [
          "resource",
          "ownership"
        ],
        "type": "object"
      },
      "Ownership": {
        "description": "Whether an owner reference controls cascading deletion.",
        "oneOf": [
          {
            "description": "The referenced resource controls this resource's lifecycle.",
            "enum": [
              "controller"
            ],
            "type": "string"
          },
          {
            "description": "The reference records provenance without controlling deletion.",
            "enum": [
              "informational"
            ],
            "type": "string"
          }
        ]
      },
      "PlacementConstraint": {
        "description": "Hard node identity and label constraints used by the scheduler.",
        "properties": {
          "labels": {
            "additionalProperties": {
              "type": "string"
            },
            "description": "Labels every eligible node must match.",
            "type": "object"
          },
          "nodeId": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/NodeId"
              },
              {
                "enum": [
                  null
                ],
                "nullable": true
              }
            ],
            "description": "Required node identity, when placement is pinned."
          }
        },
        "type": "object"
      },
      "PortRange": {
        "description": "Inclusive transport port range.",
        "properties": {
          "end": {
            "description": "Last port included by the range.",
            "format": "uint16",
            "maximum": 65535,
            "minimum": 0,
            "type": "integer"
          },
          "start": {
            "description": "First port included by the range.",
            "format": "uint16",
            "maximum": 65535,
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "start",
          "end"
        ],
        "type": "object"
      },
      "Preview": {
        "$ref": "#/components/schemas/Object12"
      },
      "PreviewId": {
        "description": "Stable identity of a pull-request preview.",
        "type": "string"
      },
      "PreviewPhase": {
        "description": "Persisted lifecycle of a pull-request preview.",
        "oneOf": [
          {
            "description": "Waiting for source inspection or derived resource creation.",
            "enum": [
              "pending"
            ],
            "type": "string"
          },
          {
            "description": "Derived resources exist and the preview can receive traffic.",
            "enum": [
              "active"
            ],
            "type": "string"
          },
          {
            "description": "Pull request closed and the grace-period finalizer is waiting.",
            "enum": [
              "closing"
            ],
            "type": "string"
          },
          {
            "description": "Derived resources were deleted after close or expiry.",
            "enum": [
              "expired"
            ],
            "type": "string"
          },
          {
            "description": "Preview reconciliation ended with a terminal configuration error.",
            "enum": [
              "failed"
            ],
            "type": "string"
          },
          {
            "description": "Preview creation was canceled before becoming active.",
            "enum": [
              "canceled"
            ],
            "type": "string"
          }
        ]
      },
      "PreviewSpec": {
        "description": "Desired pull-request preview derivation and teardown policy.",
        "properties": {
          "baseServiceId": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ServiceId"
              }
            ],
            "description": "Base service copied into the isolated preview service."
          },
          "closeGracePeriodSecs": {
            "description": "Grace period between pull-request close and teardown.",
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "expiresAt": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Timestamp"
              }
            ],
            "description": "Absolute preview expiry time."
          },
          "headRevision": {
            "description": "Current pull-request head revision.",
            "type": "string"
          },
          "pullRequestNumber": {
            "description": "Pull-request number within the repository.",
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "repository": {
            "description": "Source repository in `owner/name` form.",
            "type": "string"
          },
          "serviceId": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ServiceId"
              }
            ],
            "description": "Derived service identity owned by this preview."
          }
        },
        "required": [
          "baseServiceId",
          "repository",
          "pullRequestNumber",
          "headRevision",
          "serviceId",
          "closeGracePeriodSecs",
          "expiresAt"
        ],
        "type": "object"
      },
      "PreviewStatus": {
        "description": "Observed derived resource and teardown state of a preview.",
        "properties": {
          "conditions": {
            "description": "Generic source, quota, rollout, and teardown evidence.",
            "items": {
              "$ref": "#/components/schemas/Condition"
            },
            "type": "array"
          },
          "phase": {
            "allOf": [
              {
                "$ref": "#/components/schemas/PreviewPhase"
              }
            ],
            "description": "Current preview phase."
          },
          "teardownAt": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Timestamp"
              },
              {
                "enum": [
                  null
                ],
                "nullable": true
              }
            ],
            "description": "Time teardown may proceed after a close event."
          }
        },
        "required": [
          "phase"
        ],
        "type": "object"
      },
      "ReplicaState": {
        "$ref": "#/components/schemas/Object6"
      },
      "ReplicaStateId": {
        "description": "Stable identity of a deployment replica's observed state.",
        "type": "string"
      },
      "ReplicaStateSpec": {
        "description": "Desired identity of one observable deployment replica slot.",
        "properties": {
          "assignmentId": {
            "allOf": [
              {
                "$ref": "#/components/schemas/AssignmentId"
              }
            ],
            "description": "Current assignment for the slot."
          },
          "deploymentId": {
            "allOf": [
              {
                "$ref": "#/components/schemas/DeploymentId"
              }
            ],
            "description": "Deployment owning the slot."
          },
          "replicaIndex": {
            "description": "Zero-based replica slot within the deployment.",
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "serviceId": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ServiceId"
              }
            ],
            "description": "Service owning the slot."
          }
        },
        "required": [
          "serviceId",
          "deploymentId",
          "assignmentId",
          "replicaIndex"
        ],
        "type": "object"
      },
      "ReplicaStateStatus": {
        "description": "Health and restart evidence observed for one replica slot.",
        "properties": {
          "conditions": {
            "description": "Generic health and exhaustion evidence.",
            "items": {
              "$ref": "#/components/schemas/Condition"
            },
            "type": "array"
          },
          "healthcheckFailures": {
            "description": "Consecutive failed health probes.",
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "nodeId": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/NodeId"
              },
              {
                "enum": [
                  null
                ],
                "nullable": true
              }
            ],
            "description": "Current node when assigned."
          },
          "phase": {
            "allOf": [
              {
                "$ref": "#/components/schemas/DeploymentPhase"
              }
            ],
            "description": "Deployment lifecycle phase observed for the replica."
          },
          "restartAttempts": {
            "description": "Restart attempts consumed by this assignment.",
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "restartNotBefore": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Timestamp"
              },
              {
                "enum": [
                  null
                ],
                "nullable": true
              }
            ],
            "description": "Earliest UTC time at which the pending restart may be attempted."
          },
          "restartPendingAttempt": {
            "description": "Attempt durably reserved before a runtime restart and cleared after it is observed running.",
            "format": "uint32",
            "minimum": 0,
            "nullable": true,
            "type": "integer"
          },
          "workloadId": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/WorkloadId"
              },
              {
                "enum": [
                  null
                ],
                "nullable": true
              }
            ],
            "description": "Current runtime workload identity."
          }
        },
        "required": [
          "phase",
          "healthcheckFailures",
          "restartAttempts"
        ],
        "type": "object"
      },
      "ResourceId": {
        "description": "An open reference to a built-in or future custom resource.",
        "properties": {
          "id": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ResourceName"
              }
            ],
            "description": "Identity interpreted by the selected kind."
          },
          "kind": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ResourceKind"
              }
            ],
            "description": "Open kind name resolved through the API type registry."
          }
        },
        "required": [
          "kind",
          "id"
        ],
        "type": "object"
      },
      "ResourceKind": {
        "description": "Open resource kind name used by generic registries and owner references.",
        "type": "string"
      },
      "ResourceName": {
        "description": "Open resource identity used together with a resource kind.",
        "type": "string"
      },
      "ResourceRevision": {
        "description": "Monotonic store revision observed for a resource.",
        "format": "uint64",
        "minimum": 0,
        "type": "integer"
      },
      "RolloutState": {
        "description": "Whether new service deployments may begin.",
        "oneOf": [
          {
            "description": "New deployments may proceed.",
            "enum": [
              "active"
            ],
            "type": "string"
          },
          {
            "description": "New deployments remain queued until explicitly unfrozen.",
            "enum": [
              "frozen"
            ],
            "type": "string"
          }
        ]
      },
      "SecretMountSpec": {
        "description": "Secret values rendered into one private, read-only workload file.",
        "properties": {
          "items": {
            "additionalProperties": {
              "$ref": "#/components/schemas/SecretValue"
            },
            "description": "Dotenv keys and plaintext values encrypted by the store boundary.",
            "type": "object"
          },
          "mountPath": {
            "description": "Absolute workload-visible file path.",
            "type": "string"
          }
        },
        "required": [
          "mountPath"
        ],
        "type": "object"
      },
      "SecretValue": {
        "description": "A secret-bearing wire value whose debug representation is always redacted.",
        "type": "string"
      },
      "Service": {
        "$ref": "#/components/schemas/Object3"
      },
      "ServiceId": {
        "description": "Stable identity of a deployable service.",
        "type": "string"
      },
      "ServiceSpec": {
        "description": "Desired service configuration used to create immutable deployments.",
        "properties": {
          "artifact": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ArtifactTemplate"
              }
            ],
            "description": "Artifact selection or build template."
          },
          "command": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/CommandSpec"
              },
              {
                "enum": [
                  null
                ],
                "nullable": true
              }
            ],
            "description": "Optional command override."
          },
          "environment": {
            "additionalProperties": {
              "type": "string"
            },
            "description": "Non-secret runtime environment.",
            "type": "object"
          },
          "exec": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ExecPolicy"
              }
            ],
            "description": "Interactive exec policy."
          },
          "exposedPorts": {
            "description": "Runtime ports exposed to other cluster workloads.",
            "items": {
              "format": "uint16",
              "maximum": 65535,
              "minimum": 0,
              "type": "integer"
            },
            "type": "array"
          },
          "healthCheck": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/HealthCheckSpec"
              },
              {
                "enum": [
                  null
                ],
                "nullable": true
              }
            ],
            "description": "Optional workload health policy."
          },
          "maxRestarts": {
            "description": "Maximum restarts per assignment, or unlimited when absent.",
            "format": "uint32",
            "minimum": 0,
            "nullable": true,
            "type": "integer"
          },
          "name": {
            "description": "Operator-facing service name.",
            "type": "string"
          },
          "nodeApi": {
            "allOf": [
              {
                "$ref": "#/components/schemas/NodeApiAccess"
              }
            ],
            "default": "disabled",
            "description": "Private downward API, OTLP ingest, and optional privileged Control access."
          },
          "placement": {
            "allOf": [
              {
                "$ref": "#/components/schemas/PlacementConstraint"
              }
            ],
            "default": {},
            "description": "Hard scheduling constraints."
          },
          "replicas": {
            "description": "Configured replica floor before a temporary override.",
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "secrets": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/SecretMountSpec"
              },
              {
                "enum": [
                  null
                ],
                "nullable": true
              }
            ],
            "description": "Secret values delivered through a private read-only file mount."
          },
          "user": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/WorkloadUserSpec"
              },
              {
                "enum": [
                  null
                ],
                "nullable": true
              }
            ],
            "description": "Explicit numeric process identity, required when the node API is enabled."
          },
          "version": {
            "description": "Operator-supplied version used in rollout history.",
            "type": "string"
          },
          "volumes": {
            "description": "Filesystem mounts.",
            "items": {
              "$ref": "#/components/schemas/VolumeMountSpec"
            },
            "type": "array"
          }
        },
        "required": [
          "name",
          "version",
          "artifact",
          "replicas",
          "exec"
        ],
        "type": "object"
      },
      "ServiceStatus": {
        "description": "Observed rollout state and active deployment of a service.",
        "properties": {
          "activeDeploymentId": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/DeploymentId"
              },
              {
                "enum": [
                  null
                ],
                "nullable": true
              }
            ],
            "description": "Deployment currently receiving service traffic."
          },
          "conditions": {
            "description": "Generic readiness and rollout evidence.",
            "items": {
              "$ref": "#/components/schemas/Condition"
            },
            "type": "array"
          },
          "replicaOverride": {
            "description": "Temporary replica count override, or the configured floor when absent.",
            "format": "uint32",
            "minimum": 0,
            "nullable": true,
            "type": "integer"
          },
          "rollout": {
            "allOf": [
              {
                "$ref": "#/components/schemas/RolloutState"
              }
            ],
            "description": "Whether new rollouts may begin."
          }
        },
        "required": [
          "rollout"
        ],
        "type": "object"
      },
      "SessionAffinity": {
        "description": "Optional header-based affinity applied by ingress.",
        "properties": {
          "header": {
            "description": "HTTP header carrying the opaque affinity token.",
            "type": "string"
          }
        },
        "required": [
          "header"
        ],
        "type": "object"
      },
      "Timestamp": {
        "description": "A UTC Unix timestamp represented in milliseconds.",
        "format": "int64",
        "type": "integer"
      },
      "TrafficGeneration": {
        "$ref": "#/components/schemas/Object8"
      },
      "TrafficGenerationId": {
        "description": "Stable identity of an ingress traffic generation.",
        "type": "string"
      },
      "TrafficGenerationPhase": {
        "description": "Persisted cutover lifecycle of a traffic generation.",
        "oneOf": [
          {
            "description": "Configuration is prepared but does not yet receive traffic.",
            "enum": [
              "staged"
            ],
            "type": "string"
          },
          {
            "description": "Configuration is published and receives traffic.",
            "enum": [
              "active"
            ],
            "type": "string"
          },
          {
            "description": "Configuration is no longer referenced and may be collected.",
            "enum": [
              "retired"
            ],
            "type": "string"
          }
        ]
      },
      "TrafficGenerationSpec": {
        "description": "Desired immutable target set staged for an ingress cutover.",
        "properties": {
          "deploymentId": {
            "allOf": [
              {
                "$ref": "#/components/schemas/DeploymentId"
              }
            ],
            "description": "Deployment receiving traffic in this generation."
          },
          "routeIds": {
            "description": "Routes published with the target set.",
            "items": {
              "$ref": "#/components/schemas/IngressRouteId"
            },
            "type": "array"
          },
          "serviceId": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ServiceId"
              }
            ],
            "description": "Service whose traffic is changing."
          },
          "targets": {
            "description": "Ready workload targets included in the generation.",
            "items": {
              "$ref": "#/components/schemas/TrafficTarget"
            },
            "type": "array"
          }
        },
        "required": [
          "serviceId",
          "deploymentId",
          "routeIds",
          "targets"
        ],
        "type": "object"
      },
      "TrafficGenerationStatus": {
        "description": "Observed publication and garbage-collection state for one generation.",
        "properties": {
          "conditions": {
            "description": "Generic readiness and collection evidence.",
            "items": {
              "$ref": "#/components/schemas/Condition"
            },
            "type": "array"
          },
          "phase": {
            "allOf": [
              {
                "$ref": "#/components/schemas/TrafficGenerationPhase"
              }
            ],
            "description": "Current cutover phase."
          }
        },
        "required": [
          "phase"
        ],
        "type": "object"
      },
      "TrafficTarget": {
        "description": "One cluster-routable workload selected for ingress traffic.",
        "properties": {
          "assignmentId": {
            "allOf": [
              {
                "$ref": "#/components/schemas/AssignmentId"
              }
            ],
            "description": "Assignment owning this target."
          },
          "endpoint": {
            "description": "Workload address and ingress port dialed directly over the mesh.",
            "type": "string"
          }
        },
        "required": [
          "assignmentId",
          "endpoint"
        ],
        "type": "object"
      },
      "TransportProtocol": {
        "description": "Transport protocol selected by a firewall rule.",
        "oneOf": [
          {
            "description": "Transmission Control Protocol.",
            "enum": [
              "tcp"
            ],
            "type": "string"
          },
          {
            "description": "User Datagram Protocol.",
            "enum": [
              "udp"
            ],
            "type": "string"
          },
          {
            "description": "Any transport protocol.",
            "enum": [
              "any"
            ],
            "type": "string"
          }
        ]
      },
      "UpgradeMode": {
        "description": "Node batching strategy for one cluster upgrade run.",
        "oneOf": [
          {
            "description": "Upgrade one node at a time while preserving workload and store availability.",
            "enum": [
              "rolling"
            ],
            "type": "string"
          },
          {
            "description": "Drain all nodes, then apply one coordinated batch.",
            "enum": [
              "allNodes"
            ],
            "type": "string"
          }
        ]
      },
      "UpgradePhase": {
        "description": "Persisted lifecycle shared by rolling and all-node upgrade modes.",
        "oneOf": [
          {
            "description": "Waiting for the upgrade operator.",
            "enum": [
              "pending"
            ],
            "type": "string"
          },
          {
            "description": "Selected nodes are becoming unschedulable and draining workloads.",
            "enum": [
              "draining"
            ],
            "type": "string"
          },
          {
            "description": "The upgrade source is being staged or applied.",
            "enum": [
              "applying"
            ],
            "type": "string"
          },
          {
            "description": "A node restart was requested and has not yet been observed.",
            "enum": [
              "restarting"
            ],
            "type": "string"
          },
          {
            "description": "Running version and node health are being verified.",
            "enum": [
              "verifying"
            ],
            "type": "string"
          },
          {
            "description": "Every selected node reached the target version and was restored.",
            "enum": [
              "completed"
            ],
            "type": "string"
          },
          {
            "description": "A terminal or retry-exhausted failure occurred.",
            "enum": [
              "failed"
            ],
            "type": "string"
          },
          {
            "description": "The run was canceled and owned drains were restored.",
            "enum": [
              "canceled"
            ],
            "type": "string"
          }
        ]
      },
      "UpgradeRun": {
        "$ref": "#/components/schemas/Object13"
      },
      "UpgradeRunId": {
        "description": "Stable identity of a persisted cluster upgrade run.",
        "type": "string"
      },
      "UpgradeRunSpec": {
        "description": "Desired target and batching for one cluster upgrade.",
        "properties": {
          "mode": {
            "allOf": [
              {
                "$ref": "#/components/schemas/UpgradeMode"
              }
            ],
            "description": "Node batching strategy."
          },
          "nodeIds": {
            "description": "Explicit node selection, or every eligible node when empty.",
            "items": {
              "$ref": "#/components/schemas/NodeId"
            },
            "type": "array"
          },
          "targetVersion": {
            "description": "Minimum semantic version every selected node must reach.",
            "type": "string"
          }
        },
        "required": [
          "targetVersion",
          "mode"
        ],
        "type": "object"
      },
      "UpgradeRunStatus": {
        "description": "Observed aggregate and per-node progress of an upgrade run.",
        "properties": {
          "conditions": {
            "description": "Generic leadership, retry, and restoration evidence.",
            "items": {
              "$ref": "#/components/schemas/Condition"
            },
            "type": "array"
          },
          "nodes": {
            "description": "Per-node progress in deterministic maintenance order.",
            "items": {
              "$ref": "#/components/schemas/NodeUpgradeStatus"
            },
            "type": "array"
          },
          "phase": {
            "allOf": [
              {
                "$ref": "#/components/schemas/UpgradePhase"
              }
            ],
            "description": "Aggregate run phase."
          }
        },
        "required": [
          "phase"
        ],
        "type": "object"
      },
      "VolumeAccess": {
        "description": "Read/write policy for a mounted volume.",
        "oneOf": [
          {
            "description": "The workload can read and write the mount.",
            "enum": [
              "readWrite"
            ],
            "type": "string"
          },
          {
            "description": "The workload can only read the mount.",
            "enum": [
              "readOnly"
            ],
            "type": "string"
          }
        ]
      },
      "VolumeMountSpec": {
        "description": "One filesystem mount in a service workload.",
        "properties": {
          "access": {
            "allOf": [
              {
                "$ref": "#/components/schemas/VolumeAccess"
              }
            ],
            "description": "Workload access mode."
          },
          "source": {
            "allOf": [
              {
                "$ref": "#/components/schemas/VolumeSource"
              }
            ],
            "description": "Storage source."
          },
          "target": {
            "description": "Absolute path visible inside the workload.",
            "type": "string"
          }
        },
        "required": [
          "source",
          "target",
          "access"
        ],
        "type": "object"
      },
      "VolumeSource": {
        "description": "Storage source mounted into a workload.",
        "oneOf": [
          {
            "description": "A path on one specific node, which pins scheduling to that node.",
            "properties": {
              "nodeId": {
                "allOf": [
                  {
                    "$ref": "#/components/schemas/NodeId"
                  }
                ],
                "description": "Node that owns the path."
              },
              "path": {
                "description": "Absolute path on the node.",
                "type": "string"
              },
              "type": {
                "enum": [
                  "hostPath"
                ],
                "type": "string"
              }
            },
            "required": [
              "type",
              "path",
              "nodeId"
            ],
            "type": "object"
          },
          {
            "description": "A runtime-managed named volume.",
            "properties": {
              "name": {
                "description": "Stable runtime volume name.",
                "type": "string"
              },
              "type": {
                "enum": [
                  "managed"
                ],
                "type": "string"
              }
            },
            "required": [
              "type",
              "name"
            ],
            "type": "object"
          }
        ]
      },
      "Webhook": {
        "$ref": "#/components/schemas/Object14"
      },
      "WebhookEvent": {
        "description": "Built-in event that may be delivered to an outbound webhook.",
        "oneOf": [
          {
            "description": "A deployment changed lifecycle phase.",
            "enum": [
              "deploymentTransition"
            ],
            "type": "string"
          },
          {
            "description": "A node became unavailable or recovered.",
            "enum": [
              "nodeAvailability"
            ],
            "type": "string"
          },
          {
            "description": "A preview changed lifecycle phase.",
            "enum": [
              "previewTransition"
            ],
            "type": "string"
          },
          {
            "description": "An upgrade run changed lifecycle phase.",
            "enum": [
              "upgradeTransition"
            ],
            "type": "string"
          }
        ]
      },
      "WebhookId": {
        "description": "Stable identity of a webhook configuration.",
        "type": "string"
      },
      "WebhookSpec": {
        "description": "Desired endpoint, event selection, and signing material for a webhook.",
        "properties": {
          "endpoint": {
            "description": "HTTPS endpoint receiving event deliveries.",
            "type": "string"
          },
          "events": {
            "description": "Event classes delivered to the endpoint.",
            "items": {
              "$ref": "#/components/schemas/WebhookEvent"
            },
            "type": "array"
          },
          "signingSecret": {
            "allOf": [
              {
                "$ref": "#/components/schemas/SecretValue"
              }
            ],
            "description": "Secret used to sign delivery payloads."
          }
        },
        "required": [
          "endpoint",
          "events",
          "signingSecret"
        ],
        "type": "object"
      },
      "WebhookStatus": {
        "description": "Observed delivery health of a webhook.",
        "properties": {
          "conditions": {
            "description": "Generic validation and delivery evidence.",
            "items": {
              "$ref": "#/components/schemas/Condition"
            },
            "type": "array"
          },
          "consecutiveFailures": {
            "description": "Consecutive delivery failures since the last success.",
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "lastSuccessAt": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Timestamp"
              },
              {
                "enum": [
                  null
                ],
                "nullable": true
              }
            ],
            "description": "Time of the most recent successful delivery."
          }
        },
        "required": [
          "consecutiveFailures"
        ],
        "type": "object"
      },
      "WorkloadId": {
        "description": "Stable identity of one runtime-managed workload instance.",
        "type": "string"
      },
      "WorkloadUserSpec": {
        "description": "Numeric runtime identity used for process launch and Unix peer authorization.",
        "properties": {
          "groupId": {
            "description": "Primary group identity inside the workload.",
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "userId": {
            "description": "User identity inside the workload and on the node when user namespaces are absent.",
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "userId",
          "groupId"
        ],
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Maestro Cloud API",
    "version": "0.1.0"
  },
  "openapi": "3.0.4",
  "paths": {}
}
