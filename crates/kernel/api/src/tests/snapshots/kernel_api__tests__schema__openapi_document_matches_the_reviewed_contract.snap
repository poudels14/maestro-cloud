      },
      "ServiceSpec": {
        "description": "Desired service configuration used to create immutable deployments.",
        "properties": {
          "artifact": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ArtifactTemplate"
              }
            ],
            "description": "Artifact selection or build template."
          },
          "command": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/CommandSpec"
              },
              {
                "enum": [
                  null
                ],
                "nullable": true
              }
            ],
            "description": "Optional command override."
          },
          "environment": {
            "additionalProperties": {
              "type": "string"
            },
            "description": "Non-secret runtime environment.",
            "type": "object"
          },
          "exec": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ExecPolicy"
              }
            ],
            "description": "Interactive exec policy."
          },
          "exposedPorts": {
            "description": "Runtime ports exposed to other cluster workloads.",
            "items": {
              "format": "uint16",
              "maximum": 65535,
              "minimum": 0,
              "type": "integer"
            },
            "type": "array"
          },
          "healthCheck": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/HealthCheckSpec"
              },
              {
                "enum": [
                  null
                ],
                "nullable": true
              }
            ],
            "description": "Optional workload health policy."
          },
          "maxRestarts": {
            "description": "Maximum restarts per assignment, or unlimited when absent.",
            "format": "uint32",
            "minimum": 0,
            "nullable": true,
            "type": "integer"
          },
          "name": {
            "description": "Operator-facing service name.",
            "type": "string"
          },
          "nodeApi": {
            "allOf": [
              {
                "$ref": "#/components/schemas/NodeApiAccess"
              }
            ],
            "default": "disabled",
            "description": "Private downward API, OTLP ingest, and optional privileged Control access."
          },
          "placement": {
            "allOf": [
              {
                "$ref": "#/components/schemas/PlacementConstraint"
              }
            ],
            "default": {},
            "description": "Scheduling constraints and replica-distribution policy."
          },
          "preview": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/PreviewPolicy"
              },
              {
                "enum": [
                  null
                ],
                "nullable": true
              }
            ],
            "description": "Pull-request preview policy; absence disables preview discovery."
          },
          "replicas": {
            "description": "Configured replica floor before a temporary override.",
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "secrets": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/SecretMountSpec"
              },
              {
                "enum": [
                  null
                ],
                "nullable": true
              }
            ],
            "description": "Secret values delivered through a private read-only file mount."
          },
          "user": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/WorkloadUserSpec"
              },
              {
                "enum": [
                  null
                ],
                "nullable": true
              }
            ],
            "description": "Explicit numeric process identity, required when the node API is enabled."
          },
          "version": {
            "description": "Operator-supplied version used in rollout history.",
            "type": "string"
          },
          "volumes": {
            "description": "Filesystem mounts.",
            "items": {
              "$ref": "#/components/schemas/VolumeMountSpec"
            },
            "type": "array"
          }
        },
        "required": [
          "name",
          "version",
          "artifact",
          "replicas",
          "exec"
        ],
        "type": "object"
      },
      "ServiceStatus": {
        "description": "Observed rollout state and active deployment of a service.",
        "properties": {
          "activeDeploymentId": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/DeploymentId"
              },
              {
                "enum": [
                  null
                ],
                "nullable": true
              }
            ],
            "description": "Deployment currently receiving service traffic."
          },
          "conditions": {
            "description": "Generic readiness and rollout evidence.",
            "items": {
              "$ref": "#/components/schemas/Condition"
            },
            "type": "array"
          },
          "replicaOverride": {
            "description": "Temporary replica count override, or the configured floor when absent.",
            "format": "uint32",
            "minimum": 0,
            "nullable": true,
            "type": "integer"
          },
          "rollout": {
            "allOf": [
              {
                "$ref": "#/components/schemas/RolloutState"
              }
            ],
            "description": "Whether new rollouts may begin."
          },
          "rolloutBypassGeneration": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Generation"
              },
              {
                "enum": [
                  null
                ],
                "nullable": true
              }
            ],
            "description": "Service generation whose next deployment may bypass a rollout freeze once."
          }
        },
        "required": [
          "rollout"
        ],
        "type": "object"
      },
      "ServiceWriteRequest": {
        "additionalProperties": false,
        "description": "Optimistic desired-state replacement for one service.",
        "properties": {
          "expectedRevision": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ResourceRevision"
              },
              {
                "enum": [
                  null
                ],
                "nullable": true
              }
            ],
            "description": "Revision observed by the caller, or absence when creating the service."
          },
          "spec": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ServiceSpec"
              }
            ],
            "description": "Complete desired service state."
          }
        },
        "required": [
          "spec"
        ],
        "type": "object"
      },
      "ServiceWriteResponse": {
        "description": "Accepted service desired-state generation.",
        "properties": {
          "generation": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Generation"
              }
            ],
            "description": "Desired generation after the write."
          },
          "serviceId": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ServiceId"
              }
            ],
            "description": "Service whose desired state was accepted."
          }
        },
        "required": [
          "serviceId",
          "generation"
        ],
        "type": "object"
      },
      "SessionAffinity": {
        "description": "Optional header-based affinity applied by ingress.",
        "properties": {
          "header": {
            "description": "HTTP header carrying the opaque affinity token.",
            "type": "string"
          }
        },
        "required": [
          "header"
        ],
        "type": "object"
      },
      "Timestamp": {
        "description": "A UTC Unix timestamp represented in milliseconds.",
        "format": "int64",
        "type": "integer"
      },
      "TrafficGeneration": {
        "$ref": "#/components/schemas/Object11"
      },
      "TrafficGenerationId": {
        "description": "Stable identity of an ingress traffic generation.",
        "type": "string"
      },
      "TrafficGenerationPhase": {
        "description": "Persisted cutover lifecycle of a traffic generation.",
        "oneOf": [
          {
            "description": "Configuration is prepared but does not yet receive traffic.",
            "enum": [
              "staged"
            ],
            "type": "string"
          },
          {
            "description": "Configuration is published and receives traffic.",
            "enum": [
              "active"
            ],
            "type": "string"
          },
          {
            "description": "Configuration is no longer referenced and may be collected.",
            "enum": [
              "retired"
            ],
            "type": "string"
          }
        ]
      },
      "TrafficGenerationSpec": {
        "description": "Desired immutable target set staged for an ingress cutover.",
        "properties": {
          "deploymentId": {
            "allOf": [
              {
                "$ref": "#/components/schemas/DeploymentId"
              }
            ],
            "description": "Deployment receiving traffic in this generation."
          },
          "epoch": {
            "description": "Monotonic per-service cutover epoch used to distinguish repeated target sets.",
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "routes": {
            "description": "Immutable routes published with the target set.",
            "items": {
              "$ref": "#/components/schemas/TrafficRoute"
            },
            "type": "array"
          },
          "serviceId": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ServiceId"
              }
            ],
            "description": "Service whose traffic is changing."
          },
          "targets": {
            "description": "Ready workload targets included in the generation.",
            "items": {
              "$ref": "#/components/schemas/TrafficTarget"
            },
            "type": "array"
          }
        },
        "required": [
          "serviceId",
          "deploymentId",
          "epoch",
          "routes",
          "targets"
        ],
        "type": "object"
      },
      "TrafficGenerationStatus": {
        "description": "Observed publication and garbage-collection state for one generation.",
        "properties": {
          "activatedAt": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Timestamp"
              },
              {
                "enum": [
                  null
                ],
                "nullable": true
              }
            ],
            "description": "Time this generation began receiving traffic."
          },
          "conditions": {
            "description": "Generic readiness and collection evidence.",
            "items": {
              "$ref": "#/components/schemas/Condition"
            },
            "type": "array"
          },
          "phase": {
            "allOf": [
              {
                "$ref": "#/components/schemas/TrafficGenerationPhase"
              }
            ],
            "description": "Current cutover phase."
          },
          "retiredAt": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Timestamp"
              },
              {
                "enum": [
                  null
                ],
                "nullable": true
              }
            ],
            "description": "Time this generation stopped receiving new traffic."
          },
          "stagedAt": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Timestamp"
              }
            ],
            "description": "Time the immutable generation was staged."
          }
        },
        "required": [
          "phase",
          "stagedAt"
        ],
        "type": "object"
      },
      "TrafficRoute": {
        "description": "Immutable route configuration captured for one traffic generation.",
        "properties": {
          "hosts": {
            "description": "Canonical hostnames accepted by the route.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "pathPrefix": {
            "description": "Optional path prefix required after the host matches.",
            "nullable": true,
            "type": "string"
          },
          "routeGeneration": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Generation"
              }
            ],
            "description": "Desired route generation included in this traffic generation."
          },
          "routeId": {
            "allOf": [
              {
                "$ref": "#/components/schemas/IngressRouteId"
              }
            ],
            "description": "Ingress route whose desired generation was captured."
          },
          "sessionAffinity": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/SessionAffinity"
              },
              {
                "enum": [
                  null
                ],
                "nullable": true
              }
            ],
            "description": "Optional opaque-header affinity policy."
          },
          "targetPort": {
            "description": "Workload port receiving requests.",
            "format": "uint16",
            "maximum": 65535,
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "routeId",
          "routeGeneration",
          "hosts",
          "targetPort"
        ],
        "type": "object"
      },
      "TrafficTarget": {
        "description": "One cluster-routable workload selected for ingress traffic.",
        "properties": {
          "assignmentId": {
            "allOf": [
              {
                "$ref": "#/components/schemas/AssignmentId"
              }
            ],
            "description": "Assignment owning this target."
          },
          "endpoint": {
            "description": "Workload address and ingress port dialed directly over the mesh.",
            "type": "string"
          },
          "nodeId": {
            "allOf": [
              {
                "$ref": "#/components/schemas/NodeId"
              }
            ],
            "description": "Node hosting the assignment, used only to group opaque affinity targets."
          }
        },
        "required": [
          "assignmentId",
          "nodeId",
          "endpoint"
        ],
        "type": "object"
      },
      "TransportProtocol": {
        "description": "Transport protocol selected by a firewall rule.",
        "oneOf": [
          {
            "description": "Transmission Control Protocol.",
            "enum": [
              "tcp"
            ],
            "type": "string"
          },
          {
            "description": "User Datagram Protocol.",
            "enum": [
              "udp"
            ],
            "type": "string"
          },
          {
            "description": "Any transport protocol.",
            "enum": [
              "any"
            ],
            "type": "string"
          }
        ]
      },
      "UnschedulableReplica": {
        "description": "One requested replica slot for which the scheduler found no valid placement.",
        "properties": {
          "deploymentId": {
            "allOf": [
              {
                "$ref": "#/components/schemas/DeploymentId"
              }
            ],
            "description": "Deployment owning the replica."
          },
          "reason": {
            "description": "Human-readable placement failure suitable for operator diagnostics.",
            "type": "string"
          },
          "replicaIndex": {
            "description": "Stable replica slot within the deployment.",
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "serviceId": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ServiceId"
              }
            ],
            "description": "Service owning the replica."
          }
        },
        "required": [
          "serviceId",
          "deploymentId",
          "replicaIndex",
          "reason"
        ],
        "type": "object"
      },
      "UpgradeMode": {
        "description": "Node batching strategy for one cluster maintenance run.",
        "oneOf": [
          {
            "description": "Upgrade one node at a time while preserving workload and store availability.",
            "enum": [
              "rolling"
            ],
            "type": "string"
          },
          {
            "description": "Drain all nodes, then apply one coordinated batch.",
            "enum": [
              "allNodes"
            ],
            "type": "string"
          }
        ]
      },
      "UpgradeOperation": {
        "description": "Host mutation performed by the shared cluster-maintenance state machine.",
        "oneOf": [
          {
            "description": "Stage a new boot generation before restarting each selected node.",
            "enum": [
              "upgrade"
            ],
            "type": "string"
          },
          {
            "description": "Preserve the installed generation and only restart each selected node.",
            "enum": [
              "restart"
            ],
            "type": "string"
          }
        ]
      },
      "UpgradePhase": {
        "description": "Persisted lifecycle shared by rolling and all-node upgrade modes.",
        "oneOf": [
          {
            "description": "Waiting for the upgrade operator.",
            "enum": [
              "pending"
            ],
            "type": "string"
          },
          {
            "description": "Selected nodes are becoming unschedulable and draining workloads.",
            "enum": [
              "draining"
            ],
            "type": "string"
          },
          {
            "description": "The upgrade source is being staged or applied.",
            "enum": [
              "applying"
            ],
            "type": "string"
          },
          {
            "description": "A node restart was requested and has not yet been observed.",
            "enum": [
              "restarting"
            ],
            "type": "string"
          },
          {
            "description": "Running version and node health are being verified.",
            "enum": [
              "verifying"
            ],
            "type": "string"
          },
          {
            "description": "Every selected node reached the target version and was restored.",
            "enum": [
              "completed"
            ],
            "type": "string"
          },
          {
            "description": "A terminal or retry-exhausted failure occurred.",
            "enum": [
              "failed"
            ],
            "type": "string"
          },
          {
            "description": "The run was canceled and owned drains were restored.",
            "enum": [
              "canceled"
            ],
            "type": "string"
          }
        ]
      },
      "UpgradeRun": {
        "$ref": "#/components/schemas/Object16"
      },
      "UpgradeRunId": {
        "description": "Stable identity of a persisted cluster upgrade run.",
        "type": "string"
      },
      "UpgradeRunSpec": {
        "description": "Desired operation, target, and batching for one cluster maintenance run.",
        "properties": {
          "mode": {
            "allOf": [
              {
                "$ref": "#/components/schemas/UpgradeMode"
              }
            ],
            "description": "Node batching strategy."
          },
          "nodeIds": {
            "description": "Explicit node selection, or every eligible node when empty.",
            "items": {
              "$ref": "#/components/schemas/NodeId"
            },
            "type": "array"
          },
          "operation": {
            "allOf": [
              {
                "$ref": "#/components/schemas/UpgradeOperation"
              }
            ],
            "description": "Whether nodes stage an upgrade or only restart their installed generation."
          },
          "targetVersion": {
            "description": "Minimum semantic version for upgrades; restart runs carry `0.0.0`.",
            "type": "string"
          }
        },
        "required": [
          "operation",
          "targetVersion",
          "mode"
        ],
        "type": "object"
      },
      "UpgradeRunStatus": {
        "description": "Observed aggregate and per-node progress of an upgrade run.",
        "properties": {
          "conditions": {
            "description": "Generic leadership, retry, and restoration evidence.",
            "items": {
              "$ref": "#/components/schemas/Condition"
            },
            "type": "array"
          },
          "nodes": {
            "description": "Per-node progress in deterministic maintenance order.",
            "items": {
              "$ref": "#/components/schemas/NodeUpgradeStatus"
            },
            "type": "array"
          },
          "phase": {
            "allOf": [
              {
                "$ref": "#/components/schemas/UpgradePhase"
              }
            ],
            "description": "Aggregate run phase."
          }
        },
        "required": [
          "phase"
        ],
        "type": "object"
      },
      "VolumeAccess": {
        "description": "Read/write policy for a mounted volume.",
        "oneOf": [
          {
            "description": "The workload can read and write the mount.",
            "enum": [
              "readWrite"
            ],
            "type": "string"
          },
          {
            "description": "The workload can only read the mount.",
            "enum": [
              "readOnly"
            ],
            "type": "string"
          }
        ]
      },
      "VolumeMountSpec": {
        "description": "One filesystem mount in a service workload.",
        "properties": {
          "access": {
            "allOf": [
              {
                "$ref": "#/components/schemas/VolumeAccess"
              }
            ],
            "description": "Workload access mode."
          },
          "source": {
            "allOf": [
              {
                "$ref": "#/components/schemas/VolumeSource"
              }
            ],
            "description": "Storage source."
          },
          "target": {
            "description": "Absolute path visible inside the workload.",
            "type": "string"
          }
        },
        "required": [
          "source",
          "target",
          "access"
        ],
        "type": "object"
      },
      "VolumeSource": {
        "description": "Storage source mounted into a workload.",
        "oneOf": [
          {
            "description": "A path on one specific node, which pins scheduling to that node.",
            "properties": {
              "nodeId": {
                "allOf": [
                  {
                    "$ref": "#/components/schemas/NodeId"
                  }
                ],
                "description": "Node that owns the path."
              },
              "path": {
                "description": "Absolute path on the node.",
                "type": "string"
              },
              "type": {
                "enum": [
                  "hostPath"
                ],
                "type": "string"
              }
            },
            "required": [
              "type",
              "path",
              "nodeId"
            ],
            "type": "object"
          },
          {
            "description": "A runtime-managed named volume.",
            "properties": {
              "name": {
                "description": "Stable runtime volume name.",
                "type": "string"
              },
              "type": {
                "enum": [
                  "managed"
                ],
                "type": "string"
              }
            },
            "required": [
              "type",
              "name"
            ],
            "type": "object"
          },
          {
            "description": "A runtime-managed volume isolated to one active rollout replica.",
            "properties": {
              "name": {
                "description": "Stable volume name within the rollout replica.",
                "type": "string"
              },
              "type": {
                "enum": [
                  "replicaManaged"
                ],
                "type": "string"
              }
            },
            "required": [
              "type",
              "name"
            ],
            "type": "object"
          }
        ]
      },
      "Webhook": {
        "$ref": "#/components/schemas/Object17"
      },
      "WebhookCategory": {
        "description": "Notification severity selected independently from event classes.",
        "oneOf": [
          {
            "description": "Normal lifecycle progress and recovery.",
            "enum": [
              "info"
            ],
            "type": "string"
          },
          {
            "description": "Failed deployments, unavailable nodes, and failed automation.",
            "enum": [
              "error"
            ],
            "type": "string"
          }
        ]
      },
      "WebhookEvent": {
        "description": "Built-in event that may be delivered to an outbound webhook.",
        "oneOf": [
          {
            "description": "A deployment changed lifecycle phase.",
            "enum": [
              "deploymentTransition"
            ],
            "type": "string"
          },
          {
            "description": "A node became unavailable or recovered.",
            "enum": [
              "nodeAvailability"
            ],
            "type": "string"
          },
          {
            "description": "A preview changed lifecycle phase.",
            "enum": [
              "previewTransition"
            ],
            "type": "string"
          },
          {
            "description": "An upgrade run changed lifecycle phase.",
            "enum": [
              "upgradeTransition"
            ],
            "type": "string"
          }
        ]
      },
      "WebhookFormat": {
        "description": "Wire representation used by an outbound webhook endpoint.",
        "oneOf": [
          {
            "description": "Signed Maestro transition document with deterministic delivery identity.",
            "enum": [
              "maestro"
            ],
            "type": "string"
          },
          {
            "description": "Slack incoming-webhook document containing only the human-readable text.",
            "enum": [
              "slack"
            ],
            "type": "string"
          }
        ]
      },
      "WebhookId": {
        "description": "Stable identity of a webhook configuration.",
        "type": "string"
      },
      "WebhookNodeAvailability": {
        "description": "Availability state derived from a node's session-bound liveness key.",
        "oneOf": [
          {
            "description": "The node owns an active liveness session.",
            "enum": [
              "available"
            ],
            "type": "string"
          },
          {
            "description": "The node's liveness session is absent or expired.",
            "enum": [
              "unavailable"
            ],
            "type": "string"
          }
        ]
      },
      "WebhookObservation": {
        "description": "Last state durably acknowledged for one subscribed resource.",
        "properties": {
          "resourceId": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ResourceName"
              }
            ],
            "description": "Built-in resource identity within its event class."
          },
          "resourceRevision": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ResourceRevision"
              }
            ],
            "description": "Source store revision used to derive the delivery identity."
          },
          "state": {
            "allOf": [
              {
                "$ref": "#/components/schemas/WebhookObservedState"
              }
            ],
            "description": "Exact typed state acknowledged by the endpoint."
          }
        },
        "required": [
          "resourceId",
          "state",
          "resourceRevision"
        ],
        "type": "object"
      },
      "WebhookObservedState": {
        "description": "Typed state carried by one webhook transition.",
        "oneOf": [
          {
            "description": "Deployment lifecycle phase.",
            "properties": {
              "event": {
                "enum": [
                  "deploymentTransition"
                ],
                "type": "string"
              },
              "state": {
                "$ref": "#/components/schemas/DeploymentPhase"
              }
            },
            "required": [
              "event",
              "state"
            ],
            "type": "object"
          },
          {
            "description": "Node session availability.",
            "properties": {
              "event": {
                "enum": [
                  "nodeAvailability"
                ],
                "type": "string"
              },
              "state": {
                "$ref": "#/components/schemas/WebhookNodeAvailability"
              }
            },
            "required": [
              "event",
              "state"
            ],
            "type": "object"
          },
          {
            "description": "Pull-request preview lifecycle phase.",
            "properties": {
              "event": {
                "enum": [
                  "previewTransition"
                ],
                "type": "string"
              },
              "state": {
                "$ref": "#/components/schemas/PreviewPhase"
              }
            },
            "required": [
              "event",
              "state"
            ],
            "type": "object"
          },
          {
            "description": "Cluster upgrade lifecycle phase.",
            "properties": {
              "event": {
                "enum": [
                  "upgradeTransition"
                ],
                "type": "string"
              },
              "state": {
                "$ref": "#/components/schemas/UpgradePhase"
              }
            },
            "required": [
              "event",
              "state"
            ],
            "type": "object"
          }
        ]
      },
      "WebhookSpec": {
        "description": "Desired endpoint, event selection, and signing material for a webhook.",
        "properties": {
          "categories": {
            "default": [
              "info",
              "error"
            ],
            "description": "Notification severities delivered within the selected event classes.",
            "items": {
              "$ref": "#/components/schemas/WebhookCategory"
            },
            "type": "array"
          },
          "enabled": {
            "default": true,
            "description": "Whether transitions are delivered or only baselined.",
            "type": "boolean"
          },
          "endpoint": {
            "allOf": [
              {
                "$ref": "#/components/schemas/SecretValue"
              }
            ],
            "description": "HTTPS endpoint receiving event deliveries, potentially including credentials."
          },
          "events": {
            "description": "Event classes delivered to the endpoint.",
            "items": {
              "$ref": "#/components/schemas/WebhookEvent"
            },
            "type": "array"
          },
          "format": {
            "allOf": [
              {
                "$ref": "#/components/schemas/WebhookFormat"
              }
            ],
            "default": "maestro",
            "description": "Endpoint-specific wire representation."
          },
          "name": {
            "description": "Operator-facing display name.",
            "type": "string"
          },
          "signingSecret": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/SecretValue"
              },
              {
                "enum": [
                  null
                ],
                "nullable": true
              }
            ],
            "description": "Secret used to sign native Maestro payloads; Slack does not use it."
          }
        },
        "required": [
          "endpoint",
          "events"
        ],
        "type": "object"
      },
      "WebhookStatus": {
        "description": "Observed delivery health of a webhook.",
        "properties": {
          "conditions": {
            "description": "Generic validation and delivery evidence.",
            "items": {
              "$ref": "#/components/schemas/Condition"
            },
            "type": "array"
          },
          "consecutiveFailures": {
            "description": "Consecutive delivery failures since the last success.",
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "lastSuccessAt": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Timestamp"
              },
              {
                "enum": [
                  null
                ],
                "nullable": true
              }
            ],
            "description": "Time of the most recent successful delivery."
          },
          "observations": {
            "description": "Last successfully acknowledged state for each subscribed resource.",
            "items": {
              "$ref": "#/components/schemas/WebhookObservation"
            },
            "type": "array"
          },
          "observedGeneration": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Generation"
              },
              {
                "enum": [
                  null
                ],
                "nullable": true
              }
            ],
            "description": "Webhook generation whose subscribed resources were last baselined."
          },
          "retryAt": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Timestamp"
              },
              {
                "enum": [
                  null
                ],
                "nullable": true
              }
            ],
            "description": "Earliest wall-clock time a failed transition may be retried."
          }
        },
        "required": [
          "consecutiveFailures"
        ],
        "type": "object"
      },
      "WorkloadId": {
        "description": "Stable identity of one runtime-managed workload instance.",
        "type": "string"
      },
      "WorkloadNetworkMode": {
        "description": "Ownership of workload addressing and cross-node routing on one node.",
        "oneOf": [
          {
            "description": "Maestro allocates stable addresses from the node's routed subnet.",
            "enum": [
              "clusterRouted"
            ],
            "type": "string"
          },
          {
            "description": "The local runtime assigns addresses that the node agent reports.",
            "enum": [
              "runtimeDelegated"
            ],
            "type": "string"
          }
        ]
      },
      "WorkloadUserSpec": {
        "description": "Numeric runtime identity used for process launch and Unix peer authorization.",
        "properties": {
          "groupId": {
            "description": "Primary group identity inside the workload.",
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "userId": {
            "description": "User identity inside the workload and on the node when user namespaces are absent.",
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "userId",
          "groupId"
        ],
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Maestro Cloud API",
    "version": "0.6.4"
  },
  "openapi": "3.0.4",
  "paths": {}
}
