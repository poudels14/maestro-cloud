        },
        "required": [
          "kind",
          "id"
        ],
        "type": "object"
      },
      "ResourceKind": {
        "description": "Open resource kind name used by generic registries and owner references.",
        "type": "string"
      },
      "ResourceName": {
        "description": "Open resource identity used together with a resource kind.",
        "type": "string"
      },
      "ResourceRevision": {
        "description": "Monotonic store revision observed for a resource.",
        "format": "uint64",
        "minimum": 0,
        "type": "integer"
      },
      "RolloutState": {
        "description": "Whether new service deployments may begin.",
        "oneOf": [
          {
            "description": "New deployments may proceed.",
            "enum": [
              "active"
            ],
            "type": "string"
          },
          {
            "description": "New deployments remain queued until explicitly unfrozen.",
            "enum": [
              "frozen"
            ],
            "type": "string"
          }
        ]
      },
      "SecretMountSpec": {
        "description": "Secret values rendered into one private, read-only workload mount.",
        "oneOf": [
          {
            "description": "One dotenv-compatible file containing environment-style keys.",
            "properties": {
              "format": {
                "enum": [
                  "dotenv"
                ],
                "type": "string"
              },
              "items": {
                "additionalProperties": {
