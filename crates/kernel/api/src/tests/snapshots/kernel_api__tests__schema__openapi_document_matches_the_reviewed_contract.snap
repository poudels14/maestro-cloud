              }
            ],
            "description": "Stable ingress route, or absence to remove the managed route."
          },
          "service": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ServiceSpec"
              }
            ],
            "description": "Service workload and artifact desired state."
          }
