{
  "services": {
    "my-service": {
      "name": "My Service",
      "build": {
        "dockerfile": "Dockerfile"
      },
      "ingress": {
        "host": "my-service.local",
        "port": 80
      },
      "deploy": {
        "healthcheckPath": "/health",
        "replicas": 1
      }
    }
  }
}
